            <span style="position:absolute; top:0.75rem; right:0.75rem; background:#0284c7; color:#fff; font-size:0.7rem; font-weight:700; padding:0.25rem 0.6rem; border-radius:50px; text-transform:uppercase;">Eco Sanctuary</span>
          </div>
          <div class="card-content">
            <span class="card-badge badge-package">Paje Village</span>
