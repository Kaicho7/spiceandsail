  <section class="featured-section section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Featured</span>
        <h2>Most Popular Tours</h2>
        <p>Hand-picked experiences our guests love — from cultural walks to marine adventures.</p>
      </div>
      <div class="cards-grid">
        {% set featured = tours | limit(6) %}
        {% for tour in featured %}
          <article class="card featured-card reveal" data-category="{{ tour.category }}">
            <div class="card-image" style="position:relative;">
              {% set tourSlug = tour.seo_slug %}
              {% if tourSlug and __slugMap[tourSlug] %}
                {% set mapSlug = __slugMap[tourSlug] %}
                {% set meta = __metadataIndex[mapSlug] %}
                {% if meta %}
                  {% set imgFile = meta.file if meta.file else mapSlug %}
                  {% set imgAlt = meta.alt_text if meta.alt_text else tour.title %}
                  <img src="{{ imgFile | cdnFile }}" alt="{{ imgAlt }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
                {% else %}
                  <img src="{{ mapSlug | cdnFile }}" alt="{{ tour.title }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
                {% endif %}
              {% else %}
                <img src="{{ 'default-tour-hero.jpg' | cdnFile }}" alt="{{ tour.title }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
              {% endif %}
            </div>
            <button class="card-favorite" aria-label="Add to favorites">♡</button>
            <div class="card-content">
              <span class="card-badge badge-{{ tour.category | lower }}">{{ tour.category | attractionTypeLabel }}</span>
              <h3 class="card-title"><a href="/tours/{{ tour.seo_slug }}/">{{ tour.title }}</a></h3>
              <p class="card-meta">{{ tour.duration }} • {{ tour.location }}</p>
              <p class="card-description">{{ tour.short_description }}</p>
              <div class="card-footer">
                <span class="card-price">{{ tour.price.display }} <span class="price-basis">per person</span></span>
                <div class="card-actions">
                  <a href="/tours/{{ tour.seo_slug }}/" class="btn btn-primary btn-sm">View Details</a>
                  <a href="https://wa.me/255672450934?text=Hello%20Spice%20and%20Sail%2C%20I%27m%20interested%20in%20{{ tour.title | urlencode }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Ask on WhatsApp</a>
                </div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      <p class="view-all reveal"><a href="/tours/" class="btn btn-secondary">View All {{ stats.total_tours }} Tours →</a></p>
    </div>
  </section>

