        <div class="card reveal" style="padding:1.5rem;">
          <h3 style="margin-top:0;">🌊 Wind & Kite Season</h3>
          <ul style="margin:0;padding-left:1.25rem;line-height:1.8;">
            <li><strong>Jun–Sep:</strong> { areaData.climate.windKnots["Jun–Sep"] }</li>
            <li><strong>Dec–Mar:</strong> { areaData.climate.windKnots["Dec–Mar"] }</li>
          </ul>
