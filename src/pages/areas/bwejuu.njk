          <div><strong>Budget:</strong> Mar–May, Nov (low season rates)</div>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Who It's For</span>
        <h2>Is Bwejuu Right for You?</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;">
        <div class="card reveal" style="padding:1.5rem;border-left:4px solid #28a745;">
          <h3 style="margin-top:0;">✅ Perfect For</h3>
          <ul style="margin:0;padding-left:1.25rem;line-height:1.8;">
            {% for item in areaData.demographics.bestFor %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="card reveal" style="padding:1.5rem;border-left:4px solid #dc3545;">
          <h3 style="margin-top:0;">⚠️ Less Suited</h3>
          <ul style="margin:0;padding-left:1.25rem;line-height:1.8;">
            {% for item in areaData.demographics.lessSuited %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="card reveal" style="padding:1.5rem;background:#f8fafc;">
          <h3 style="margin-top:0;">🌟 Vibe Check</h3>
          <p style="margin:0;color:#4e5d66;line-height:1.7;">{{ areaData.demographics.vibe }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Tours</span>
        <h2>Recommended Tours from Bwejuu / Dongwe</h2>
        <p class="section-subtitle">The best day tours and experiences starting from Bwejuu / Dongwe.</p>
      </div>
      <div class="cards-grid tour-grid">
{% for tour in tours | filterByZone(title) %}
  <article class="card tour-card reveal" data-category="{{ tour.category }}">
    <div class="card-image" style="position:relative;">
      <img src="{{ (__slugMap[tour.seo_slug] or __slugMap[tour.slug] or 'excursions.png') | cdnFile }}" alt="{{ tour.title }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-{{ tour.category | lower }}">{{ tour.category | attractionTypeLabel }}</span>
      <h3 class="card-title"><a href="/tours/{{ tour.seo_slug }}/">{{ tour.title }}</a></h3>
      <p class="card-meta">{{ tour.duration }} • {{ tour.location }}</p>
      <p class="card-description">{{ tour.short_description }}</p>
      <div class="card-footer">
        <span class="card-price">{% catPrice tour.slug %} <span class="price-basis">per person</span></span>
        <a href="/tours/{{ tour.seo_slug }}/" class="btn btn-primary btn-sm">Details & Booking</a>
      </div>
    </div>
  </article>
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="text-align: center; max-width: 600px;">
      <div class="reveal">
        <h2 style="margin-bottom: 1rem;">Need an Airport Transfer?</h2>
        <p style="color: var(--dct-text-muted); margin-bottom: 1.5rem;">Private transfer from ZNZ Airport to Bwejuu / Dongwe -- fixed price, flight tracking, meet & greet included.</p>
        <a href="/transfers/" class="btn btn-primary btn-lg">View Transfer Options</a>
      </div>
    </div>
  </section>
</main>

