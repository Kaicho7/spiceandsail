---
title: "Wambaa Gulf, Pemba"
description: "Pemba's luxury lodge area — Fundu Lagoon, world-class diving, and untouched coral reefs."
permalink: "/areas/wambaa-gulf/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="area-detail">
  <section class="area-hero" style="background: linear-gradient(135deg, var(--dct-ocean) 0%, var(--dct-palm) 100%);">
    <div class="area-hero-content">
      <div class="area-tags">
        <span class="area-tag">Pemba Island</span>
        <span class="area-tag">Luxury Resorts</span>
      </div>
      <h1>Wambaa Gulf / Makangale (Pemba)</h1>
      <p class="area-description">Pemba's luxury lodge area — Fundu Lagoon, world-class diving, and untouched coral reefs.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">At a Glance</span>
        <h2>Wambaa Gulf / Makangale (Pemba) Quick Stats</h2>
      </div>
      <div class="stats-grid" style="max-width: 600px; margin: 0 auto;">
        <div class="stat-item reveal"><span class="stat-number">2</span><span class="stat-label">Partner Hotels</span></div>
        <div class="stat-item reveal"><span class="stat-number">1</span><span class="stat-label">Attractions</span></div>
        <div class="stat-item reveal"><span class="stat-number">0</span><span class="stat-label">Recommended Tours</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Where to Stay</span>
        <h2>Where to Stay in Wambaa Gulf / Makangale (Pemba)</h2>
        <p class="section-subtitle">Boutique hotels and resorts in Wambaa Gulf / Makangale (Pemba). Click through for direct booking or contact us for referral rates.</p>
      </div>
      <div class="cards-grid hotel-grid">
{% for hotel in hotels %}
  {% if hotel.name in ["Fundu Lagoon", "The Manta Resort", "Dive 360 Pemba", "Fun Divers Zanzibar", "Swahili Divers"] %}
  <article class="card hotel-card reveal" data-tier="{{ hotel.tier }}" data-zone="{{ hotel.zone }}" data-island="{{ hotel.island }}">
    <div class="card-content">
      <span class="card-badge badge-{{ hotel.tier | lower | replace('upper-', '') }}">{{ hotel.tier | capitalize }}</span>
      <h3 class="card-title"><a href="{{ hotel.website }}" target="_blank" rel="noopener">{{ hotel.name }}</a></h3>
      <p class="card-meta">{{ hotel.zone }}{% if hotel.zone %}, {% endif %}{{ hotel.island }} • {{ hotel.star_rating or "Ungraded" }}</p>
      {% if hotel.category %}<p class="card-description">{{ hotel.category }}</p>{% endif %}
      <div class="card-footer">
        <span class="card-price">{{ hotel.price_range or "Contact for rates" }}</span>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="{{ hotel.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">View Website</a>
          {% if hotel.whatsapp %}
          <a href="https://wa.me/{{ hotel.whatsapp | replace('+', '') | replace(' ', '') }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">WhatsApp</a>
          {% endif %}
        </div>
      </div>
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-gradient">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Attractions</span>
        <h2>Attractions in Wambaa Gulf / Makangale (Pemba)</h2>
        <p class="section-subtitle">Local attractions, dive centers, and activity providers in Wambaa Gulf / Makangale (Pemba).</p>
      </div>
      <div class="cards-grid attraction-grid">
{% for attraction in attractions %}
  {% if attraction.name in ["Dive 360 Pemba", "Fundu Lagoon / 710 Dive", "Fun Divers Zanzibar"] %}
  <article class="card attraction-card reveal" data-type="{{ attraction.category }}">
    <div class="card-image" style="position:relative;">
      <img src="{{ (attraction.name | attractionImg(attraction.category)) | cdnFile }}" alt="{{ attraction.name }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-cultural">{{ attraction.type | attractionTypeLabel }}</span>
      <h3 class="card-title">{{ attraction.name }}</h3>
      <p class="card-meta">{{ attraction.zone }}{% if attraction.zone %}, {% endif %}{{ attraction.island }}</p>
      {% if attraction.website %}
        <a href="{{ attraction.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Visit Website</a>
      {% else %}
        <a href="https://wa.me/255672450934?text=Hi%20Spice%20and%20Sail%2C%20please%20send%20prices%20and%20a%20bookable%20slot%20for%20{{ hotel.name | urlencode }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Book via WhatsApp</a>
      {% endif %}
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="text-align: center; max-width: 600px;">
      <div class="reveal">
        <h2 style="margin-bottom: 1rem;">Need an Airport Transfer?</h2>
        <p style="color: var(--dct-text-muted); margin-bottom: 1.5rem;">Private transfer from ZNZ Airport to Wambaa Gulf / Makangale (Pemba) — fixed price, flight tracking, meet & greet included.</p>
        <a href="/transfers/" class="btn btn-primary btn-lg">View Transfer Options</a>
      </div>
    </div>
  </section>
</main>

{% include "footer.njk" %}
