---
title: "Jambiani"
description: "Southeast fishing village — authentic Swahili culture, seaweed farming, tide pools, and access to Kuza Cave and Chumbe Island."
permalink: "/areas/jambiani/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="area-detail">
  <section class="area-hero" style="background: linear-gradient(rgba(0, 61, 92, 0.78), rgba(0, 38, 59, 0.88)), url('{{ title | zoneImg | cdnFile }}') center/cover no-repeat; color: #fff;">
    <div class="area-hero-content">
      <div class="area-tags">
        <span class="area-tag">Unguja (Main Island)</span>
      </div>
      <h1>Jambiani</h1>
      <p class="area-description">Southeast fishing village — authentic Swahili culture, seaweed farming, tide pools, and access to Kuza Cave and Chumbe Island.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">At a Glance</span>
        <h2>Jambiani Quick Stats</h2>
      </div>
      <div class="stats-grid" style="max-width: 600px; margin: 0 auto;">
        <div class="stat-item reveal"><span class="stat-number">{{ hotels.hotels | filterByZone(title) | length }}</span><span class="stat-label">Partner Hotels</span></div>
        <div class="stat-item reveal"><span class="stat-number">{{ attractions.attractions | filterByZone(title) | length }}</span><span class="stat-label">Attractions</span></div>
        <div class="stat-item reveal"><span class="stat-number">{{ tours | filterByZone(title) | length }}</span><span class="stat-label">Recommended Tours</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Where to Stay</span>
        <h2>Where to Stay in Jambiani</h2>
        <p class="section-subtitle">Boutique hotels and resorts in Jambiani. Click through for direct booking or contact us for referral rates.</p>
      </div>
      <div class="cards-grid hotel-grid">
{% for hotel in hotels.hotels | filterByZone(title) %}
  <article class="card hotel-card reveal" data-tier="{{ hotel.tier }}" data-zone="{{ hotel.zone }}" data-island="{{ hotel.island }}">
    <div class="card-image" style="position:relative;">
      {% set hImg = hotel | hotelPhoto %}
      <img src="{{ hImg | cdnFile }}" alt="{{ hImg | canonicalAlt(hotel.name) }}" loading="lazy">
      <span class="card-badge badge-{{ hotel.tier | lower | replace('upper-', '') }}">{{ hotel.tier | capitalize }}</span>
    </div>
    <div class="card-content">
      <h3 class="card-title"><a href="{{ hotel.website }}" target="_blank" rel="noopener">{{ hotel.name }}</a></h3>
      <p class="card-meta">{{ hotel.zone }}{% if hotel.zone %}, {% endif %}{{ hotel.island }} • {{ hotel.star_rating or "Ungraded" }}</p>
      {% if hotel.category %}<p class="card-description">{{ hotel.category }}</p>{% endif %}
      <div class="card-footer">
        <span class="card-price">{{ hotel.price_range or "Contact for rates" }}</span>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="{{ hotel.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">View Website</a>
          <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Hi%20Spice%20and%20Sail%2C%20I%20would%20like%20to%20inquire%20about%20rates%20for%20{{ hotel.name | urlencode }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">WhatsApp</a>
        </div>
      </div>
    </div>
  </article>
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-gradient">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Attractions</span>
        <h2>Attractions in Jambiani</h2>
        <p class="section-subtitle">Local attractions, dive centers, and activity providers in Jambiani.</p>
      </div>
      <div class="cards-grid attraction-grid">
{% for attraction in attractions.attractions | filterByZone(title) %}
  <article class="card attraction-card reveal" data-type="{{ attraction.category }}">
    <div class="card-image" style="position:relative;">
      <img src="{{ (attraction.name | attractionImg(attraction.category)) | cdnFile }}" alt="{{ attraction.name }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-cultural">{{ attraction.type | attractionTypeLabel }}</span>
      <h3 class="card-title">{{ attraction.name }}</h3>
      <p class="card-meta">{{ attraction.zone }}{% if attraction.zone %}, {% endif %}{{ attraction.island }}</p>
      {% if attraction.website %}
        <a href="{{ attraction.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Visit Website</a>
      {% else %}
        <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Hi%20Spice%20and%20Sail%2C%20please%20send%20prices%20and%20a%20bookable%20slot%20for%20{{ attraction.name | urlencode }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Book via WhatsApp</a>
      {% endif %}
    </div>
  </article>
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Tours</span>
        <h2>Recommended Tours from Jambiani</h2>
        <p class="section-subtitle">The best day tours and experiences starting from Jambiani.</p>
      </div>
      <div class="cards-grid tour-grid">
{% for tour in tours | filterByZone(title) %}
  <article class="card tour-card reveal" data-category="{{ tour.category }}">
    <div class="card-image" style="position:relative;">
      <img src="{{ (__slugMap[tour.seo_slug] or __slugMap[tour.slug] or 'excursions.png') | cdnFile }}" alt="{{ tour.title }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-{{ tour.category | lower }}">{{ tour.category | attractionTypeLabel }}</span>
      <h3 class="card-title"><a href="/tours/{{ tour.seo_slug }}/">{{ tour.title }}</a></h3>
      <p class="card-meta">{{ tour.duration }} • {{ tour.location }}</p>
      <p class="card-description">{{ tour.short_description }}</p>
      <div class="card-footer">
        <span class="card-price">{{ tour.price.display }} <span class="price-basis">per person</span></span>
        <a href="/tours/{{ tour.seo_slug }}/" class="btn btn-primary btn-sm">Details & Booking</a>
      </div>
    </div>
  </article>
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="text-align: center; max-width: 600px;">
      <div class="reveal">
        <h2 style="margin-bottom: 1rem;">Need an Airport Transfer?</h2>
        <p style="color: var(--dct-text-muted); margin-bottom: 1.5rem;">Private transfer from ZNZ Airport to Jambiani — fixed price, flight tracking, meet & greet included.</p>
        <a href="/transfers/" class="btn btn-primary btn-lg">View Transfer Options</a>
      </div>
    </div>
  </section>
</main>

{% include "footer.njk" %}
