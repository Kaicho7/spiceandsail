      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .item-info {
      padding: 1rem;
      flex: 1;
    }

    .item-info h3 {
      color: #1E3A8A;
      margin-bottom: 0.5rem;
      font-size: 1.1rem;
    }

    .item-meta {
      color: #64748B;
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
    }

    .item-description {
      color: #6B7280;
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
    }

    .item-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .price {
      font-weight: bold;
      color: #059669;
      font-size: 1.1rem;
    }

    .category-tag {
      background: #E0F2FE;
      color: #0369A1;
      padding: 0.25rem 0.5rem;
      border-radius: 12px;
      font-size: 0.8rem;
    }

    .itinerary-main {
      padding: 1.5rem;
    }

    .itinerary-main h2 {
      color: #1E3A8A;
      margin-bottom: 1.5rem;
