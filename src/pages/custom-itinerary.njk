---
title: "Custom Zanzibar Itinerary Planner | Spice & Sail"
description: "Design your tailored Zanzibar itinerary: handpicked excursions, private island transfers, beach stays, and safari extensions arranged directly with local experts."
canonical: https://spiceandsail.com/custom-itinerary/
permalink: /custom-itinerary/index.html
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="custom-itinerary-page" style="max-width: 960px; margin: 0 auto; padding: 3rem 1.5rem; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <header style="text-align: center; margin-bottom: 2.5rem;">
    <span style="display: inline-block; background: #e0f2fe; color: #0369a1; padding: 0.35rem 1rem; border-radius: 9999px; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.75rem;">
      Tailor-Made Island Travel · WhatsApp-First
    </span>
    <h1 style="font-size: 2.5rem; color: #0f172a; margin-bottom: 0.75rem;">Custom Zanzibar Itinerary Builder</h1>
    <p style="color: #475569; font-size: 1.15rem; max-width: 650px; margin: 0 auto; line-height: 1.6;">
      Tell us your travel dates, preferred pace, and bucket-list activities. Our licensed local team will craft a seamless day-by-day plan with private transfers and marine park fees fully included.
    </p>
  </header>

  <form id="custom-itinerary-form" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
    <!-- Step 1: Trip Duration -->
    <div style="margin-bottom: 2rem;">
      <h3 style="font-size: 1.2rem; color: #0f172a; margin-bottom: 0.75rem;">1. How long is your Zanzibar stay?</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem;">
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="duration" value="3 Days (Quick Getaway)" checked>
          <span>3 Days (Essentials)</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="duration" value="5 Days (Classic Island)">
          <span>5 Days (Classic Island)</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="duration" value="7 Days (Island & Safari)">
          <span>7 Days (Island &amp; Safari)</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="duration" value="10+ Days (Extended Stay)">
          <span>10+ Days (Grand Tour)</span>
        </label>
      </div>
    </div>

    <!-- Step 2: Preferred Experiences -->
    <div style="margin-bottom: 2rem;">
      <h3 style="font-size: 1.2rem; color: #0f172a; margin-bottom: 0.75rem;">2. What experiences are on your bucket list?</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem;">
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" name="activities" value="Stone Town Walking Tour" checked>
          <span>Stone Town Culture</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" name="activities" value="Safari Blue Dhow" checked>
          <span>Safari Blue Dhow Cruise</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" name="activities" value="Mnemba Snorkeling">
          <span>Mnemba Atoll Snorkeling</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" name="activities" value="Spice Farm Tour">
          <span>Spice Farm &amp; Cooking</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" name="activities" value="Jozani Forest">
          <span>Jozani Red Colobus Monkeys</span>
        </label>
        <label style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" name="activities" value="Mikumi Fly-in Safari">
          <span>Mikumi Day Safari Fly-In</span>
        </label>
      </div>
    </div>

    <!-- Step 3: Travel Dates & Party Size -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
      <div>
        <label style="display: block; font-weight: 600; color: #0f172a; margin-bottom: 0.35rem;" for="itinerary-travelers">Travelers (Adults + Kids)</label>
        <select id="itinerary-travelers" name="travelers" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px;">
          <option value="1 Traveler (Solo)">1 Traveler (Solo)</option>
          <option value="2 Travelers (Couple)" selected>2 Travelers (Couple)</option>
          <option value="3-4 Travelers (Family / Small Group)">3–4 Travelers (Family)</option>
          <option value="5-8 Travelers (Private Group Minivan)">5–8 Travelers (Group Minivan)</option>
          <option value="9+ Travelers (Large Party)">9+ Travelers (Large Party)</option>
        </select>
      </div>
      <div>
        <label style="display: block; font-weight: 600; color: #0f172a; margin-bottom: 0.35rem;" for="itinerary-hotel">Hotel or Arrival Area</label>
        <input type="text" id="itinerary-hotel" placeholder="e.g. Nungwi, Paje, Stone Town..." style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box;">
      </div>
    </div>

    <!-- Submit CTAs -->
    <div style="text-align: center; border-top: 1px solid #e2e8f0; padding-top: 2rem;">
      <button type="button" id="build-wa-itinerary" class="btn btn-primary btn-lg" style="background: #16a34a; border-color: #16a34a; color: white; padding: 0.85rem 2.25rem; border-radius: 8px; font-weight: 700; font-size: 1.05rem; cursor: pointer; margin-right: 0.75rem;">
        💬 Plan on WhatsApp (+255 672 450 934)
      </button>
      <button type="button" onclick="window.snsConcierge && window.snsConcierge.open()" class="btn btn-secondary btn-lg" style="padding: 0.85rem 1.75rem; border-radius: 8px; font-weight: 600; font-size: 1.05rem; cursor: pointer;">
        Use Website Concierge Form
      </button>
    </div>
  </form>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var waBtn = document.getElementById('build-wa-itinerary');
      if (waBtn) {
        waBtn.addEventListener('click', function() {
          var form = document.getElementById('custom-itinerary-form');
          var duration = form.querySelector('input[name="duration"]:checked') ? form.querySelector('input[name="duration"]:checked').value : '5 Days';
          var activities = [];
          form.querySelectorAll('input[name="activities"]:checked').forEach(function(cb) {
            activities.push(cb.value);
          });
          var travelers = document.getElementById('itinerary-travelers').value;
          var hotel = (document.getElementById('itinerary-hotel').value || '').trim();

          var msg = "Hi Spice & Sail! I'd like a custom Zanzibar itinerary:\n" +
            "• Duration: " + duration + "\n" +
            "• Party: " + travelers + "\n" +
            (hotel ? "• Staying at: " + hotel + "\n" : "") +
            "• Preferred Highlights: " + (activities.join(', ') || 'Recommend top activities') + "\n\n" +
            "Please send recommended day-by-day plan and quote.";

          var url = "https://wa.me/255672450934?text=" + encodeURIComponent(msg);
          window.open(url, '_blank', 'noopener,noreferrer');
        });
      }
    });
  </script>
</main>

{% include "footer.njk" %}
