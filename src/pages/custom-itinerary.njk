    }

    .day-item-info p {
      color: #6B7280;
      font-size: 0.85rem;
      margin-bottom: 0.25rem;
    }

    .item-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.75rem;
      color: #9CA3AF;
    }

    .remove-day-item {
      background: #EF4444;
      color: white;
      border: none;
