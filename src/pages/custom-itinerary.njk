      color: #374151;
      margin-bottom: 0.25rem;
    }

    .day-stats {
      font-size: 0.85rem;
      color: #6B7280;
    }

    .day-items {
      min-height: 200px;
    }

    .day-item {
      background: white;
      border-radius: 6px;
      padding: 0.75rem;
      margin-bottom: 0.75rem;
