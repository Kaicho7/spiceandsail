  <!-- Client-side Unified Filter & Search Script -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('hotel-search-input');
    const countIndicator = document.getElementById('hotel-count-indicator');
    const cards = document.querySelectorAll('.hotel-card');
    const noHotelsMsg = document.getElementById('no-hotels-msg');

    let activeZone = 'all';
    let activeTier = 'all';
    let searchQuery = '';

    const filterButtons = document.querySelectorAll('[data-filter-type]');

    function filterHotels() {
      let visibleCount = 0;

      cards.forEach(card => {
        const zone = (card.getAttribute('data-zone') || '').toLowerCase();
        const tier = (card.getAttribute('data-tier') || '').toLowerCase();
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const island = (card.getAttribute('data-island') || '').toLowerCase();

        let matchesZone = true;
        if (activeZone !== 'all') {
          if (activeZone === 'pemba') {
            matchesZone = island.includes('pemba') || zone.includes('pemba') || zone.includes('chake') || zone.includes('wambaa');
          } else if (activeZone === 'matemwe') {
            matchesZone = zone.includes('matemwe') || zone.includes('kiwengwa') || zone.includes('kigomani');
          } else if (activeZone === 'paje') {
            matchesZone = zone.includes('paje') || zone.includes('jambiani');
          } else if (activeZone === 'nungwi') {
            matchesZone = zone.includes('nungwi') || zone.includes('kendwa');
          } else if (activeZone === 'michamvi') {
            matchesZone = zone.includes('michamvi') || zone.includes('bwejuu') || zone.includes('dongwe') || zone.includes('pingwe') || zone.includes('pongwe');
          } else if (activeZone === 'kizimkazi') {
            matchesZone = zone.includes('kizimkazi') || zone.includes('fumba') || zone.includes('dimbani') || zone.includes('mbweni') || zone.includes('makunduchi');
          } else {
            matchesZone = zone.includes(activeZone);
          }
        }

        let matchesTier = true;
        if (activeTier !== 'all') {
          matchesTier = tier === activeTier;
        }

        let matchesSearch = true;
        if (searchQuery) {
          matchesSearch = name.includes(searchQuery) || zone.includes(searchQuery);
        }

        if (matchesZone && matchesTier && matchesSearch) {
          card.style.display = 'flex';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
          card.classList.add('visible');
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countIndicator) {
        countIndicator.textContent = 'Showing ' + visibleCount + ' of ' + cards.length + ' properties';
      }

      if (noHotelsMsg) {
        noHotelsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const fType = btn.getAttribute('data-filter-type');
        const fVal = btn.getAttribute('data-filter-val');

        document.querySelectorAll('[data-filter-type="' + fType + '"]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (fType === 'zone') activeZone = fVal;
        if (fType === 'tier') activeTier = fVal;

        filterHotels();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterHotels();
      });
    }

    // Sync count to actual rendered cards on load
    filterHotels();
  });
  </script>
