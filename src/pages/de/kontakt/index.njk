  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('form[name="booking-inquiry"]');
    if (form) {
      form.addEventListener('submit', function(e) {
        var emailVal = (document.getElementById('email') ? document.getElementById('email').value : '').trim();
        var phoneVal = (document.getElementById('phone') ? document.getElementById('phone').value : '').trim();
        if (!emailVal && !phoneVal) {
          e.preventDefault();
          alert('Bitte geben Sie entweder eine WhatsApp-Nummer oder eine E-Mail-Adresse an, damit unser Team antworten kann.');
          if (document.getElementById('phone')) document.getElementById('phone').focus();
        }
      });
    }
  });
  </script>
