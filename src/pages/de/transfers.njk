                <span class="card-price" style="font-size: 1.4rem; font-weight: 800; color: #0C1A24;">{% catPrice transfer.slug %}</span>
              </div>
              <a href="https://wa.me/255672450934?text=Hallo%20Spice%20%26%20Sail%2C%20ich%20m%C3%B6chte%20den%20{{ transfer.title | urlencode }}%20buchen." target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="background: #25D366; border-color: #25D366; color: #fff; font-weight: 700;">
                💬 WhatsApp
              </a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section style="background: #0C1A24; color: #fff; padding: 4rem 1.5rem;">
    <div class="container" style="max-width: 1050px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span style="color: var(--dct-gold, #D4AF37); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;">Keine Überraschungen bei der Ankunft</span>
        <h2 style="font-size: 2.2rem; margin-top: 0.5rem; color: #fff;">Sansibar Reiseabgaben & Versicherungs-Hinweis</h2>
        <p style="color: #94a3b8; max-width: 700px; margin: 0.5rem auto 0; font-size: 0.95rem;">Alle Inhaber ausländischer Pässe bei Einreise nach Sansibar müssen die staatlichen Einreisebestimmungen und Hotelsteuern einhalten.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem;">
        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🛡️</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Obligatorische Einreiseversicherung (ZIC)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Offizieller staatlicher Auftrag: Ausländische Reisende, die Sansibar betreten, müssen die offizielle Sansibar-Einreiseversicherung von ZIC haben ($44 Erwachsener / $22 Kind, gültig 92 Tage). Kombinierte Tansania-Reisen mit erstem Festland-Einreise (DAR/JRO) folgen der Festland-Ersteinreise-Versicherung.
          </p>
          <a href="https://inbound.visitzanzibar.go.tz" target="_blank" rel="noopener" style="display: inline-block; margin-top: 0.75rem; color: var(--dct-gold, #D4AF37); font-weight: 600; font-size: 0.85rem; text-decoration: underline;">
            Auf Offiziellem Regierungsportal Beantragen (inbound.visitzanzibar.go.tz) →
          </a>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🏨</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Gestuften Hotel-Infrastrukturabgabe (ZRA)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Die Sansibar Revenue Authority (ZRA) erhebt eine gesetzliche Unterkunftsgebühr pro Gast/Nacht, die direkt beim Check-in/out erhoben wird: <strong>$5.00</strong> (4–5 Sterne), <strong>$4.00</strong> (2–3 Sterne), <strong>$2.00</strong> (1 Stern/Gästehäuser) und <strong>$10.00</strong> für ausgewiesene kleine Insel- und Unterwasser-Suiten.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #94a3b8;">
            ✓ Offizielle gesetzliche Gemeindesteuer an Hotelrezeption gezahlt.
          </div>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🚗</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Meet & Greet Garantie bei Ankunft</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Ihr zugewiesener privater Fahrer wartet in der Terminal-Ankunftshalle mit einem offiziellen Spice & Sail Namensschild. 60 Minuten kostenlose Wartezeit bei Verzögerung inklusive mit Echtzeit-Flugtracking.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #34d399;">
            ✓ Direkter WhatsApp-Koordinierung mit Betriebsleiter.
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const pickupEl = document.getElementById('calc-pickup');
    const destEl = document.getElementById('calc-dest');
    const paxEl = document.getElementById('calc-pax');
    const dateEl = document.getElementById('calc-date');
    const flightEl = document.getElementById('calc-flight');
    const fareDisplayEl = document.getElementById('calc-fare-display');
    const routeSummaryEl = document.getElementById('calc-route-summary');
    const waBtn = document.getElementById('calc-whatsapp-btn');

    const tmrw = new Date();
    tmrw.setDate(tmrw.getDate() + 1);
    if (dateEl) dateEl.value = tmrw.toISOString().split('T')[0];

    function getFareNumbers(origin, destKey) {
      const isAirportOrFerry = origin.includes('Airport') || origin.includes('Ferry');
      const isStoneTownHotel = origin.includes('Stone Town Hotel');
      const isNungwi = origin.includes('Nungwi') || origin.includes('Kendwa');
      const isPaje = origin.includes('Paje') || origin.includes('Jambiani');
      const isMatemwe = origin.includes('Matemwe') || origin.includes('Kiwengwa');

      if (isAirportOrFerry || isStoneTownHotel) {
        if (destKey === 'stone-town') return isStoneTownHotel ? [20, 25] : [35, 40];
        if (destKey === 'paje-jambiani') return [45, 55];
        if (destKey === 'matemwe') return [45, 55];
        if (destKey === 'kiwengwa-pongwe') return [45, 55];
        if (destKey === 'nungwi-kendwa') return [50, 60];
        if (destKey === 'michamvi') return [45, 55];
        if (destKey === 'kizimkazi') return [45, 55];
      } else if (isNungwi) {
        if (destKey === 'nungwi-kendwa') return [20, 25];
        if (destKey === 'stone-town') return [50, 60];
        if (destKey === 'matemwe') return [40, 50];
        if (destKey === 'kiwengwa-pongwe') return [45, 55];
        if (destKey === 'paje-jambiani') return [60, 75];
        if (destKey === 'michamvi') return [65, 80];
        if (destKey === 'kizimkazi') return [70, 85];
      } else if (isPaje) {
        if (destKey === 'paje-jambiani') return [20, 25];
        if (destKey === 'stone-town') return [45, 55];
        if (destKey === 'michamvi') return [25, 35];
        if (destKey === 'kizimkazi') return [35, 45];
        if (destKey === 'nungwi-kendwa') return [60, 75];
        if (destKey === 'matemwe') return [45, 55];
        if (destKey === 'kiwengwa-pongwe') return [45, 55];
      } else if (isMatemwe) {
        if (destKey === 'matemwe' || destKey === 'kiwengwa-pongwe') return [20, 25];
        if (destKey === 'nungwi-kendwa') return [40, 50];
        if (destKey === 'stone-town') return [45, 55];
        if (destKey === 'paje-jambiani') return [45, 55];
        if (destKey === 'michamvi') return [50, 60];
        if (destKey === 'kizimkazi') return [55, 65];
      }
      return [45, 55];
    }

    function calculateFare(origin, destKey) {
      const nums = getFareNumbers(origin, destKey);
      if (window.SpiceInternational) {
        return window.SpiceInternational.formatRangeConverted(nums[0], nums[1], window.SpiceInternational.getCurrency());
      }
      return '$' + nums[0] + '–$' + nums[1];
    }

    function updateCalculator() {
      if (!destEl || !paxEl) return;
      const selectedOption = destEl.options[destEl.selectedIndex];
      const slug = selectedOption.getAttribute('data-slug') || '';
      const destZone = selectedOption.getAttribute('data-zone') || 'Ziel';
      const destKey = destEl.value;
      const paxCount = paxEl.value;

      const pickup = pickupEl ? pickupEl.value : 'ZNZ Flughafen';
      const dateVal = dateEl && dateEl.value ? dateEl.value : 'Kommendes Datum';
      const flightVal = flightEl && flightEl.value.trim() ? ' (' + flightEl.value.trim() + ')' : '';

      const nums = getFareNumbers(pickup, destKey);
      const currCode = window.SpiceInternational ? window.SpiceInternational.getCurrency() : 'USD';
      const baseFare = window.SpiceInternational
        ? window.SpiceInternational.formatRangeConverted(nums[0], nums[1], currCode)
        : '$' + nums[0] + '–$' + nums[1];

      fareDisplayEl.textContent = baseFare;
      fareDisplayEl.setAttribute('data-usd-min', nums[0]);
      fareDisplayEl.setAttribute('data-usd-max', nums[1]);

      const currCodeEl = document.getElementById('calc-curr-code');
      if (currCodeEl) currCodeEl.textContent = currCode;

      routeSummaryEl.textContent = pickup + ' → ' + destZone + ' • ' + paxCount + ' Passagiere • ' + baseFare + ' Planungsbereich — unser Team bestätigt den endgültigen Preis.';

      var lang = window.SpiceInternational ? window.SpiceInternational.getLanguage() : 'de';
      var greetings = {
        de: 'Hallo Spice & Sail! Ich möchte einen privaten Transfer reservieren:',
        en: 'Jambo Spice & Sail! I would like to reserve a Private Transfer:',
        it: 'Ciao Spice & Sail! Vorrei prenotare un Transfer Privato:',
        fr: 'Bonjour Spice & Sail ! Je souhaite réserver un transfert privé :',
        pl: 'Dzień dobry Spice & Sail! Chciałbym zarezerwować prywatny transfer:'
      };
      var greeting = greetings[lang] || greetings.de;

      const driverLangEl = document.getElementById('calc-driver-lang');
      const driverLang = driverLangEl ? driverLangEl.value : 'Englisch';
      const langNote = driverLang !== 'Englisch' ? '\n• Mehrsprachiger Fahrer Gewünscht: ' + driverLang + ' (Vorab-Anfrage — Team bestätigt Extrakosten)' : '';

      const waMessage = greeting + '\n' +
        '• Abholung: ' + pickup + flightVal + '\n' +
        '• Ziel: ' + destZone + '\n' +
        '• Datum: ' + dateVal + '\n' +
        '• Passagiere: ' + paxCount + ' Pers.\n' +
        '• Planungs-Preis: ' + baseFare + langNote + '\n' +
        'Bitte Fahrer-Verfügbarkeit und Preis bestätigen.';
      if (waBtn) waBtn.href = 'https://wa.me/255672450934?text=' + encodeURIComponent(waMessage);

      const isAirportOrFerry = pickup.includes('Airport') || pickup.includes('Ferry');
      if (!slug || !isAirportOrFerry) return;

      fetch('/.netlify/functions/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serviceSlug: slug, adults: parseInt(paxCount, 10) || 1, children: 0, date: dateVal && dateVal !== 'Kommendes Datum' ? dateVal : null })
      }).then(function (r) { return r.json(); }).then(function (q) {
        if (q && q.status === 'quoted') {
          const currentCurr = window.SpiceInternational ? window.SpiceInternational.getCurrency() : 'USD';
          let displayFare = q.totalDisplay;
          if (window.SpiceInternational && q.totalLow != null && q.totalHigh != null) {
            displayFare = window.SpiceInternational.formatRangeConverted(q.totalLow, q.totalHigh, currentCurr);
            fareDisplayEl.setAttribute('data-usd-min', q.totalLow);
            fareDisplayEl.setAttribute('data-usd-max', q.totalHigh);
          }
          fareDisplayEl.textContent = displayFare;
          routeSummaryEl.textContent = pickup + ' → ' + destZone + ' • ' + paxCount + ' Passagiere • ' + displayFare + ' Planungsbereich — unser Team bestätigt den endgültigen Preis.';
        } else if (q && q.reasons && q.reasons.length) {
          fareDisplayEl.textContent = baseFare;
          routeSummaryEl.textContent = pickup + ' → ' + destZone + ' • ' + paxCount + ' Passagiere • ' + q.reasons.join(' ');
        }
      }).catch(function () {});
    }

    const driverLangEl = document.getElementById('calc-driver-lang');
    if (pickupEl) pickupEl.addEventListener('change', updateCalculator);
    if (destEl) destEl.addEventListener('change', updateCalculator);
    if (paxEl) paxEl.addEventListener('change', updateCalculator);
    if (dateEl) dateEl.addEventListener('change', updateCalculator);
    if (flightEl) flightEl.addEventListener('input', updateCalculator);
    if (driverLangEl) driverLangEl.addEventListener('change', updateCalculator);

    window.addEventListener('spice:currency-changed', updateCalculator);
    window.addEventListener('spice:language-changed', updateCalculator);

    updateCalculator();
  });
  </script>
</main>

