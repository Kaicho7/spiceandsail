            <div style="padding: 0.75rem;">
              <strong style="color: #003853; display: block; font-size: 0.95rem;">Vanille-Orchideen-Schoten</strong>
              <span style="font-size: 0.8rem; color: #64748b;">Zarte Orchideenblüten, die handbestäubt werden, um begehrte grüne Vanilleschoten zu produzieren.</span>
            </div>
          </div>

          <div style="border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); background: #fff; border: 1px solid #e2e8ed;">
            <img src="{{ 'zanzibar-coconut-climber-butterfly-man.jpg' | cdnFile }}" alt="{{ 'zanzibar-coconut-climber-butterfly-man.jpg' | canonicalAlt }}" style="width: 100%; height: 160px; object-fit: cover;" loading="lazy">
            <div style="padding: 0.75rem;">
              <strong style="color: #003853; display: block; font-size: 0.95rem;">Der "Schmetterlingsmann" Kletterer</strong>
              <span style="font-size: 0.8rem; color: #64748b;">Akrobatischer Palmenkletterer, der Swahili-Lieder singt, während er frische Kokosnüsse (madafu) pflückt.</span>
            </div>
          </div>

          <div style="border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); background: #fff; border: 1px solid #e2e8ed;">
