---
title: Book Your Experience
---

{% raw %}
<div class="bookings-container">
  <h1>🗓️ Book Your Zanzibar Experience</h1>
  <p>Plan your perfect day with our curated activities and expert hosts</p>

  <div class="bookings-layout">
    <!-- Left Sidebar: Filters -->
    <aside class="filters-sidebar">
      <div class="filter-section">
        <h3>🔍 Filter Activities</h3>

        <div class="filter-group">
          <h4>Activity Type</h4>
          <div class="filter-options">
            <label class="filter-option">
              <input type="checkbox" value="spice-farm" v-model="filters.categories" />
              <span class="icon">🌶️</span>
              <span>Spice Farms</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="fish-market" v-model="filters.categories" />
              <span class="icon">🐟</span>
              <span>Fish Markets</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="local-cooking" v-model="filters.categories" />
              <span class="icon">👨‍🍳</span>
              <span>Cooking Classes</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="artisan-workshop" v-model="filters.categories" />
              <span class="icon">🎨</span>
              <span>Artisan Workshops</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="farm-stay" v-model="filters.categories" />
              <span class="icon">🏡</span>
              <span>Farm Stays</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="homestay" v-model="filters.categories" />
              <span class="icon">🏠</span>
              <span>Homestays</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="community-tour" v-model="filters.categories" />
              <span class="icon">🚶</span>
              <span>Community Tours</span>
            </label>
            <label class="filter-option">
              <input type="checkbox" value="cultural-center" v-model="filters.categories" />
              <span class="icon">📚</span>
              <span>Cultural Centers</span>
            </label>
          </div>
        </div>

        <div class="filter-group">
          <h4>Location</h4>
          <div class="location-select">
            <select v-model="filters.location">
              <option value="">All Locations</option>
              <option value="Stone Town">Stone Town</option>
              <option value="Mnemba Island">Mnemba Island</option>
              <option value="Deep Sea">Deep Sea</option>
              <option value="Mafia Island">Mafia Island</option>
              <option value="Earthquake Island">Earthquake Island</option>
            </select>
          </div>
        </div>

        <div class="filter-group">
          <h4>Price Range</h4>
          <div class="price-range-slider">
            <div class="slider-labels">
              <span>$10</span>
              <span>$500</span>
              <span>$1000</span>
            </div>
            <div class="price-inputs">
              <div class="input-group">
                <label>Min:</label>
                <input type="number" v-model="filters.priceMin" min="0" step="10" />
              </div>
              <div class="input-group">
                <label>Max:</label>
                <input type="number" v-model="filters.priceMax" min="0" step="10" />
              </div>
            </div>
          </div>
        </div>

        <div class="filter-group">
          <h4>Sort By</h4>
          <select v-model="filters.sort">
            <option value="rating">Highest Rated</option>
            <option value="newest">Newest First</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
          </select>
        </div>

        <button class="btn btn-primary" @click="applyFilters">Apply Filters</button>
        <button class="btn btn-secondary" @click="resetFilters">Reset Filters</button>
      </div>
    </aside>

    <!-- Main Content: Activity Listings -->
    <main class="activities-main">
      <div class="bookings-header">
        <div class="results-info">
          <p>{{ filteredActivities.length }} activities available</p>
        </div>
        <div class="view-toggle">
          <button class="btn btn-icon" :class="{ active: viewMode === 'grid' }" @click="viewMode = 'grid'">
            <span>📱</span>
          </button>
          <button class="btn btn-icon" :class="{ active: viewMode === 'list' }" @click="viewMode = 'list'">
            <span>📋</span>
          </button>
        </div>
      </div>

      <div class="activities-grid" :class="{ 'list-view': viewMode === 'list' }">
        <div v-for="activity in filteredActivities" :key="activity.id" class="activity-card" :class="{ featured: activity.metadata?.isFeatured }">
          <div class="activity-image">
            <img :src="activity.images?.[0] || '/assets/images/placeholder-activity.jpg'" :alt="activity.title" />
            <div class="activity-badge" v-if="activity.metadata?.isFeatured">
              <span>⭐ Featured</span>
            </div>
          </div>

          <div class="activity-content">
            <div class="activity-header">
              <h3>{{ activity.title }}</h3>
              <div class="activity-meta">
                <span class="category-icon">{{ categoryMetadata[activity.category] ? categoryMetadata[activity.category].icon : '' }}</span>
                <span class="category">{{ categoryMetadata[activity.category] ? categoryMetadata[activity.category].label : '' }}</span>
                <span class="rating">★ {{ activity.rating }}</span>
                <span class="reviews">({{ activity.reviewCount || 0 }} reviews)</span>
              </div>
            </div>

            <div class="activity-description">
              <p>{{ activity.description }}</p>
              <div class="activity-highlights">
                <div v-for="highlight in ((activity.highlights || [])?.slice(0, 3))" :key="highlight" class="highlight-tag">
                  {{ highlight }}
                </div>
              </div>
            </div>

            <div class="activity-location">
              <span class="location-icon">📍</span>
              <span>{{ ((activity.location || {}).area) }}</span>
            </div>

            <div class="activity-pricing">
              <div class="price">
                <span class="currency">${{ (activity.pricing || {}).basePrice }}</span>
                <span class="unit">{{ (activity.pricing || {}).priceUnit }}</span>
              </div>
              <div class="price-details" v-if="(activity.pricing || {}).discountPrice">
                <span class="original-price">${{ (activity.pricing || {}).basePrice }}</span>
                <span class="discount">Save ${{ (activity.pricing || {}).basePrice - (activity.pricing || {}).discountPrice }}</span>
              </div>
            </div>

            <div class="activity-host">
              <div class="host-avatar">
                <img :src="((activity.hostedBy || {}).avatar) || '/assets/images/host-default.jpg'" :alt="((activity.hostedBy || {}).name) || ''" />
              </div>
              <div class="host-info">
                <span class="host-name">{{ ((activity.hostedBy || {}).name) }}</span>
                <span class="host-experience">Host since {{ ((activity.hostedBy || {}).joinDate) || '2023' }}</span>
              </div>
            </div>

            <div class="activity-footer">
              <button class="btn btn-primary book-btn" @click="viewActivityDetails(activity.id)">
                View Details
              </button>
              <button class="btn btn-secondary" @click="addToFavorites(activity.id)">
                <span>♡</span>
              </button>
            </div>
          </div>
        </div>

        <div v-if="filteredActivities.length === 0" class="no-activities">
          <div class="empty-state">
            <h3>No activities found</h3>
            <p>Try adjusting your filters to see more results</p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Activity Detail Modal -->
  <div v-if="showActivityModal" class="modal-overlay" @click="closeActivityModal">
    <div class="modal-content" @click.stop>
      <button class="modal-close" @click="closeActivityModal">×</button>

      <div v-if="selectedActivity" class="activity-detail">
        <div class="detail-header">
          <h2>{{ selectedActivity.title }}</h2>
          <div class="detail-meta">
            <span class="category-icon">{{ categoryMetadata[selectedActivity.category]?.icon }}</span>
            <span class="category">{{ categoryMetadata[selectedActivity.category]?.label }}</span>
            <span class="rating">★ {{ selectedActivity.rating }}</span>
            <span class="reviews">({{ selectedActivity.reviewCount || 0 }} reviews)</span>
          </div>
        </div>

        <div class="detail-content">
          <div class="detail-images">
            <img v-for="(image, index) in selectedActivity.images" :key="index" :src="image" :alt="selectedActivity.title + ' ' + (index + 1)" />
          </div>

          <div class="detail-info">
            <div class="detail-section">
              <h3>About This Activity</h3>
              <p>{{ selectedActivity.longDescription || selectedActivity.description }}</p>
            </div>

            <div class="detail-section">
              <h3>Highlights</h3>
              <ul>
                <li v-for="highlight in selectedActivity.highlights" :key="highlight">{{ highlight }}</li>
              </ul>
            </div>

            <div class="detail-section">
              <h3>Location</h3>
              <p>{{ selectedActivity.location?.area }}, {{ selectedActivity.location?.address }}</p>
            </div>

            <div class="detail-section">
              <h3>Duration</h3>
              <p>{{ selectedActivity.duration }}</p>
            </div>

            <div class="detail-section">
              <h3>Includes</h3>
              <ul>
                <li v-for="item in selectedActivity.included" :key="item">{{ item }}</li>
              </ul>
            </div>

            <div class="detail-section">
              <h3>Not Included</h3>
              <ul>
                <li v-for="item in selectedActivity.notIncluded" :key="item">{{ item }}</li>
              </ul>
            </div>
          </div>

          <div class="detail-pricing">
            <h3>Pricing</h3>
            <div class="pricing-details">
              <div class="price-row">
                <span>Base Price:</span>
                <span class="price">${{ selectedActivity.pricing?.basePrice }} {{ selectedActivity.pricing?.priceUnit }}</span>
              </div>
              <div class="price-row" v-if="selectedActivity.pricing?.discountPrice">
                <span>Discount Price:</span>
                <span class="price discount">${{ selectedActivity.pricing.discountPrice }} {{ selectedActivity.pricing.priceUnit }}</span>
              </div>
              <div class="price-row">
                <span>Minimum Guests:</span>
                <span>{{ selectedActivity.pricing?.minimumGuests }}</span>
              </div>
              <div class="price-row">
                <span>Maximum Guests:</span>
                <span>{{ selectedActivity.pricing?.maximumGuests }}</span>
              </div>
            </div>

            <div class="detail-host">
              <h3>Hosted By</h3>
              <div class="host-info">
                <img :src="selectedActivity.hostedBy?.avatar || '/assets/images/host-default.jpg'" :alt="selectedActivity.hostedBy?.name" />
                <div>
                  <p class="host-name">{{ selectedActivity.hostedBy?.name }}</p>
                  <p class="host-bio">{{ selectedActivity.hostedBy?.bio }}</p>
                </div>
              </div>
            </div>

            <div class="detail-actions">
              <button class="btn btn-primary" @click="openBookingModal(selectedActivity.id)">
                Book Now
              </button>
              <button class="btn btn-secondary" @click="closeActivityModal">
                Close
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Booking Modal -->
  <div v-if="showBookingModal" class="modal-overlay" @click="closeBookingModal">
    <div class="modal-content" @click.stop>
      <button class="modal-close" @click="closeBookingModal">×</button>

      <div class="booking-form-container">
        <h2>Book Your Experience</h2>

        <form @submit.prevent="processBooking">
          <div class="form-group">
            <label for="bookingDate">Date *</label>
            <input type="date" id="bookingDate" v-model="bookingData.date" required />
          </div>

          <div class="form-group">
            <label for="guests">Number of Guests *</label>
            <input type="number" id="guests" v-model="bookingData.guests" min="1" :max="selectedActivity?.pricing?.maximumGuests || 10" required />
          </div>

          <div class="form-group">
            <label for="packageType">Package Type *</label>
            <select id="packageType" v-model="bookingData.packageType" required>
              <option value="">Select Package</option>
              <option value="single">Single Person</option>
              <option value="couple">Couple</option>
              <option value="family">Family</option>
            </select>
          </div>

          <div class="form-group">
            <label for="specialRequests">Special Requests</label>
            <textarea id="specialRequests" v-model="bookingData.specialRequests" rows="3"></textarea>
          </div>

          <div class="booking-summary">
            <h3>Booking Summary</h3>
            <div class="summary-item">
              <span>Activity:</span>
              <span>{{ selectedActivity?.title }}</span>
            </div>
            <div class="summary-item">
              <span>Price per person:</span>
              <span>${{ selectedActivity?.pricing?.basePrice }}</span>
            </div>
            <div class="summary-item">
              <span>Guests:</span>
              <span>{{ bookingData.guests }}</span>
            </div>
            <div class="summary-item total">
              <span>Total Price:</span>
              <span>${{ calculateTotalPrice() }}</span>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" :disabled="isProcessingBooking">
              {{ isProcessingBooking ? 'Processing...' : 'Confirm Booking' }}
            </button>
            <button type="button" class="btn btn-secondary" @click="closeBookingModal">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
.bookings-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 1rem;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.bookings-container h1 {
  text-align: center;
  color: #1e3a8a;
  margin-bottom: 0.5rem;
  font-size: 2.5rem;
}

.bookings-container > p {
  text-align: center;
  color: #64748b;
  margin-bottom: 3rem;
  font-size: 1.1rem;
}

.bookings-layout {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 2rem;
  min-height: 800px;
}

.filters-sidebar {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  height: fit-content;
  position: sticky;
  top: 2rem;
}

.filter-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.filter-section h3 {
  color: #1e3a8a;
  margin-bottom: 1rem;
  font-size: 1.2rem;
}

.filter-group h4 {
  color: #475569;
  margin-bottom: 0.5rem;
  font-size: 1rem;
  font-weight: 600;
}

.filter-options {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 6px;
  transition: background-color 0.2s;
}

.filter-option:hover {
  background-color: #f8fafc;
}

.filter-option input[type="checkbox"] {
  width: 1.2rem;
  height: 1.2rem;
  cursor: pointer;
}

.icon {
  font-size: 1.2rem;
  width: 24px;
  text-align: center;
}

.location-select select {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 1rem;
}

.price-range-slider {
  margin-top: 0.5rem;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
  color: #64748b;
}

.price-inputs {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.input-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.input-group label {
  font-size: 0.875rem;
  color: #64748b;
}

.input-group input {
  width: 80px;
  padding: 0.5rem;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 0.875rem;
}

.btn {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-primary {
  background: #3b82f6;
  color: white;
}

.btn-primary:hover {
  background: #2563eb;
}

.btn-secondary {
  background: #e2e8f0;
  color: #1e3a8a;
}

.btn-secondary:hover {
  background: #cbd5e1;
}

.btn-icon {
  padding: 0.5rem;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon.active {
  background: #3b82f6;
  color: white;
}

.btn-icon span {
  font-size: 1.2rem;
}

.activities-main {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0);
}

.bookings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #e2e8f0;
}

.results-info p {
  color: #64748b;
  font-size: 1rem;
}

.view-toggle {
  display: flex;
  gap: 0.5rem;
}

.activities-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 1.5rem;
}

.activities-grid.list-view {
  grid-template-columns: 1fr;
}

.activity-card {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  background: white;
}

.activity-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.activity-card.featured {
  border-color: #fbbf24;
  position: relative;
}

.activity-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 1;
  background: #fbbf24;
  color: #78350f;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.875rem;
  font-weight: 600;
}

.activity-image {
  position: relative;
  height: 200px;
  overflow: hidden;
}

.activity-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.activity-content {
  padding: 1.5rem;
}

.activity-header h3 {
  color: #1e3a8a;
  margin-bottom: 0.5rem;
  font-size: 1.2rem;
  line-height: 1.3;
}

.activity-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
  font-size: 0.875rem;
  color: #64748b;
}

.category-icon {
  font-size: 1.2rem;
}

.rating {
  font-weight: 600;
  color: #fbbf24;
}

.reviews {
  color: #94a3b8;
}

.activity-description p {
  color: #475569;
  margin-bottom: 0.75rem;
  line-height: 1.5;
}

.activity-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.highlight-tag {
  background: #f0fdf4;
  color: #166534;
  padding: 0.25rem 0.5rem;
  border-radius: 12px;
  font-size: 0.75rem;
}

.activity-location, .activity-host {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  font-size: 0.875rem;
  color: #64748b;
}

.location-icon, .host-avatar img {
  width: 16px;
  height: 16px;
  border-radius: 50%;
}

.activity-pricing {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding: 1rem 0;
  border-top: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
}

.price .currency {
  font-size: 1.5rem;
  font-weight: bold;
  color: #059669;
}

.price .unit {
  font-size: 0.875rem;
  color: #64748b;
}

.original-price {
  text-decoration: line-through;
  color: #94a3b8;
  margin-right: 0.5rem;
}

.discount {
  color: #dc2626;
  font-weight: 600;
}

.host-avatar img {
  width: 32px;
  height: 32px;
  border-radius: 50%;
}

.host-name {
  font-weight: 600;
  color: #1e3a8a;
  margin-bottom: 0.25rem;
}

.host-experience {
  font-size: 0.75rem;
  color: #94a3b8;
}

.activity-footer {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.book-btn {
  flex: 1;
  padding: 0.75rem;
  font-weight: 600;
}

.activity-card.list-view {
  display: grid;
  grid-template-columns: 250px 1fr auto;
  gap: 1.5rem;
}

.activity-card.list-view .activity-image {
  height: 200px;
}

.activity-card.list-view .activity-content {
  padding: 1rem;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
}

.modal-content {
  background: white;
  border-radius: 12px;
  max-width: 900px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: #ef4444;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 0.5rem 1rem;
  cursor: pointer;
  font-size: 1.2rem;
  z-index: 10;
}

.modal-close:hover {
  background: #dc2626;
}

.activity-detail {
  padding: 2rem;
}

.detail-header {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid #e2e8f0;
}

.detail-header h2 {
  color: #1e3a8a;
  margin-bottom: 0.5rem;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.875rem;
  color: #64748b;
}

.detail-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}

.detail-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.detail-images img {
  width: 100%;
  height: 150px;
  object-fit: cover;
  border-radius: 8px;
}

.detail-section {
  margin-bottom: 1.5rem;
}

.detail-section h3 {
  color: #1e3a8a;
  margin-bottom: 0.75rem;
  font-size: 1.1rem;
}

.detail-section ul {
  list-style: none;
  padding: 0;
}

.detail-section li {
  padding: 0.25rem 0;
  color: #475569;
}

.detail-pricing {
