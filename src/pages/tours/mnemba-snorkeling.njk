{% include "seo.njk" %}
{% include "header.njk" %}

<main class="" id="main-content">
  <section class="tour-hero" style="background: linear-gradient(135deg, var(--dct-ocean) 0%, var(--dct-palm) 100%);">
    <div class="tour-hero-content">
{% set featured = page.inputPath | featuredImage %}
{% set cdnSrc = page.inputPath | cdnImage %}
<img src="{{ cdnSrc }}" alt="{{ featured.featuredAlt or page.title }}" class="tour-hero-image" loading="lazy">

      <span class="card-badge badge-marine">Marine Excursion</span>
      <h1>Mnemba Atoll snorkeling / dolphin trip</h1>
      <p class="tour-meta">3–6 hours · Matemwe / Nungwi / Kendwa → Mnemba Atoll</p>
<div class="tour-price-box">
        <span class="price-label">From</span>
        <span class="price-amount">{% catPrice "mnemba-snorkeling" %}</span>
        <span class="price-note">per person</span>
      </div>

      <!-- Mnemba Atoll Snorkeling Pricing Tiers (from catalogue) -->
      <div class="pricing-table">
        <h2 style="font-size: 1.25rem; margin: 0 0 0.75rem 0;">Mnemba Atoll Snorkeling — Per-Person Rates</h2>
        <div class="pricing-tiers" style="display: grid; gap: 0.75rem;">
          {% set tiers = "mnemba-snorkeling" | catTieredDisplay | split("•") %}
          {% for tier in tiers %}
            {% set tierClean = tier | trim %}
            {% if tierClean %}
            <div class="pricing-tier" style="background: #fdfaf5; border: 1px solid #f0e8dc; border-radius: 8px; padding: 1rem;">
              <div style="font-weight: 600; color: #003853;">{{ tierClean }}</div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
        <p class="table-note" style="margin-top: 1rem; font-size: 0.85rem; color: #4e5d66;">Rates from verified catalogue. Private rates include boat, snorkel gear, fruit/water, guide, and $25 marine conservation fee. Best condition: June–October and December–March.</p>
      </div>

      <button type="button" data-sns-booking-open data-service-slug="{{ tour_slug }}" class="btn btn-primary btn-lg">Check price & book</button>
    </div>
  </section>

  {% include "tour-booking-panel.njk" %}

  <div class="tour-grid">
    <div class="tour-main">
      <section class="tour-section">
        <h2>Overview</h2>
        <p>Snorkel the pristine waters of Mnemba Atoll, Zanzibar's premier marine conservation area. Spot green sea turtles, observe colorful fish over healthy coral reefs, and enjoy fruit and water on a traditional dhow.</p>
      </section>
      <section class="tour-section">
        <h2>What to Expect</h2>
        <ul class="expect-list">
      <li>3–6 hour boat trip to Mnemba Atoll marine reserve</li>
      <li>Two snorkeling spots over vibrant coral reefs</li>
      <li>Sea turtle sightings common (resident population)</li>
      <li>Fresh fruit, water, and soft drinks on board</li>
      <li>Snorkel gear provided (mask, snorkel, life jacket)</li>
      <li>Marine conservation fee $25 (non-EAC adults) included in private rate; listed separately for shared option</li>
        </ul>
      </section>

      <section class="tour-section">
        <h2>Tour Highlights in Pictures</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
          <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
            <img src="{{ 'underwater-fish-coral-reef-zanzibar.jpg' | cdnFile }}" alt="{{ 'underwater-fish-coral-reef-zanzibar.jpg' | canonicalAlt }}" style="width: 100%; height: 160px; object-fit: cover;" loading="lazy">
            <span style="display: block; padding: 0.5rem; font-size: 0.8rem; color: #4e5d66; background: #fdfaf5; text-align: center;">Vibrant Coral Gardens</span>
          </div>
          <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
            <img src="{{ 'dolphins-swimming-near-boat-tour.jpg' | cdnFile }}" alt="{{ 'dolphins-swimming-near-boat-tour.jpg' | canonicalAlt }}" style="width: 100%; height: 160px; object-fit: cover;" loading="lazy">
            <span style="display: block; padding: 0.5rem; font-size: 0.8rem; color: #4e5d66; background: #fdfaf5; text-align: center;">Wild Dolphin Pods</span>
          </div>
          <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
            <img src="{{ 'girl-snorkel-mask-beach-sand.jpg' | cdnFile }}" alt="{{ 'girl-snorkel-mask-beach-sand.jpg' | canonicalAlt }}" style="width: 100%; height: 160px; object-fit: cover;" loading="lazy">
            <span style="display: block; padding: 0.5rem; font-size: 0.8rem; color: #4e5d66; background: #fdfaf5; text-align: center;">Crystal Shallow Reefs</span>
          </div>
        </div>
      </section>

      <section class="tour-section">
        <h2>Duration & Meeting Point</h2>
        <p><strong>Duration:</strong> 3–6 hours (morning departure recommended)</p>
        <p><strong>Meeting point:</strong> Matemwe, Nungwi, or Kendwa — pickup from nearby hotels included</p>
      </section>
      <section class="tour-section">
        <h2>Important Notes</h2>
        <ul class="notes-list">
      <li>Marine conservation fee: $25 for non-EAC adults (included in our price)</li>
      <li>Best condition: June–October and December–March</li>
      <li>Avoid "guaranteed dolphin" claims — these are unethical and often illegal</li>
      <li>Weather dependent; trips may be rescheduled in rough seas</li>
        </ul>
      </section>
      <section class="tour-section">
        <h2>Inclusions</h2>
        <ul class="includes-list">
      <li>Boat, snorkel gear, fruit/water, guide</li>
      <li>Mnemba marine conservation fee: $25 per non-EAC adult (included in private rate; listed separately for shared option)</li>
        </ul>
      </section>
      {% include "tour-reviews.njk" %}

