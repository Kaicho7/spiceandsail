description: "Our signature 3-day Zanzibar package combines Stone Town culture, a Safari Blue marine day and airport transfers in one seamless itinerary."
permalink: "/tours/zanzibar-essentials-3day/index.html"
tour_slug: "zanzibar-essentials-3day"
eleventyExcludeFromCollections: true
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="tour-detail">
  <section class="tour-hero" style="background: linear-gradient(135deg, var(--dct-spice) 0%, var(--dct-coral) 100%);">
    <div class="tour-hero-content">
      {% set featured = page.inputPath | featuredImage %}
{% set cdnSrc = page.inputPath | cdnImage %}
<img src="{{ cdnSrc }}" alt="{{ featured.featuredAlt or page.title }}" class="tour-hero-image" loading="lazy">

      <span class="card-badge badge-package">PKG — Package</span>
      <h1>Zanzibar Essentials 3-day pass</h1>
      <p class="tour-meta">3 days · Zanzibar</p>
      <div class="tour-price-box">
        <span class="price-label">From</span>
        <span class="price-amount">{% catPrice "zanzibar-essentials-3day" %}</span>
        <span class="price-note">per person</span>
      </div>
      <a href="https://wa.me/{{ site.contact.whatsapp }}?text=I%27d%20like%20to%20book%20zanzibar%20essentials%203day" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Book via WhatsApp</a>
    </div>
  </section>

  <div class="tour-grid">
    <div class="tour-main">
      <section class="tour-section">
        <h2>Overview</h2>
        <p>Our signature introduction to Zanzibar. This 3-day package covers the island's must-see highlights: the spice heritage, the marine wonderland of Menai Bay, and the cultural treasures of Stone Town — all in one seamless itinerary.</p>
      </section>
      <section class="tour-section">
        <h2>Detailed Itinerary</h2>
        <div class="itinerary-day">
          <div class="day-number">1</div>
          <h3>Day 1 — Culture</h3>
          <p>Airport arrival transfer (any zone) + Stone Town walking tour with licensed guide + Forodhani night market dinner</p>
        </div>
        <div class="itinerary-day">
          <div class="day-number">2</div>
          <h3>Day 2 — Marine</h3>
          <p>Safari Blue dhow day trip to Menai Bay Conservation Area + snorkeling + sandbank lunch</p>
        </div>
        <div class="itinerary-day">
          <div class="day-number">3</div>
          <h3>Day 3 — Nature</h3>
          <p>Spice farm tour with lunch + airport departure transfer (any zone)</p>
        </div>
      </section>
      <section class="tour-section">
        <h2>What to Expect</h2>
        <ul class="expect-list">
      <li>Return transfer, Safari Blue, Stone Town + Spice</li>
        </ul>
      </section>

      <section class="tour-section">
        <h2>Duration & Meeting Point</h2>
        <p><strong>Duration:</strong> 3 days / 2 nights (can extend)</p>
        <p><strong>Meeting point:</strong> Abeid Amani Karume International Airport (ZNZ)</p>
      </section>
      <section class="tour-section">
        <h2>Important Notes</h2>
        <ul class="notes-list">
      <li>Hotels not included — we can arrange partner accommodation at wholesale rates</li>
      <li>Marine conservation fees included: Menai Bay $10, Mnemba $25</li>
      <li>Price assumes 2+ travelers — single supplement applies</li>
      <li>Book 3+ days in advance during peak season (July–August, December–January)</li>
        </ul>
      </section>
      <section class="tour-section">
        <h2>Inclusions</h2>
        <ul class="includes-list">
      <li>Return transfer, Safari Blue, Stone Town + Spice</li>
        </ul>
      </section>
      {% include "tour-reviews.njk" %}
      {% include "tour-faq.njk" %}
    </div>

    <aside class="tour-sidebar">
      <div class="info-card">
        <h4>📍 Tour Details</h4>
        <ul>
          <li><span class="label">Duration:</span><span class="value">3 days / 2 nights (can extend)</span></li>
          <li><span class="label">Location:</span><span class="value">Zanzibar</span></li>
          <li><span class="label">Category:</span><span class="value">{{ "PKG" | attractionTypeLabel }}</span></li>
        </ul>
        <div class="booking-card">
          <div class="price">{% catPrice tour_slug %} <span style="font-size: 0.85rem; font-weight: 500; opacity: 0.85;">/ person</span></div>
          <h3>Ready to Book?</h3>
          <p style="opacity: 0.8; margin-bottom: 1.25rem;">Send us your preferred date and group size on WhatsApp. We'll confirm with a fixed price including all fees.</p>
          <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20I%20would%20like%20to%20book%20{{ title | urlencode }}" target="_blank" rel="noopener" class="btn btn-accent btn-lg">WhatsApp: {{ site.contact.whatsapp_display }}</a>
          <p class="note">✓ Verified planning range • Marine conservation fees included • Zero booking deposit</p>
        </div>
      </div>
    </aside>
  </div>
  {% include "tour-mobile-sticky.njk" %}
