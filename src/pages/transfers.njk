      <div class="calc-card" style="background: #FBF9F5; border: 1.5px solid #e2e8ed; border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(12,26,36,0.06);">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
