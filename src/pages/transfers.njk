              <option value="paje-jambiani" data-fare="45" data-zone="Paje / Jambiani">Paje & Jambiani Hotels — $45 Flat</option>
              <option value="matemwe" data-fare="45" data-zone="Matemwe">Matemwe Beach Resorts — $45 Flat</option>
              <option value="kiwengwa-pongwe" data-fare="45" data-zone="Kiwengwa / Pongwe">Kiwengwa & Pongwe — $45 Flat</option>
              <option value="nungwi-kendwa" data-fare="55" data-zone="Nungwi / Kendwa" selected>Nungwi & Kendwa Resorts — $55 Flat</option>
              <option value="michamvi" data-fare="50" data-zone="Michamvi / The Rock">Michamvi & The Rock Restaurant — $50 Flat</option>
