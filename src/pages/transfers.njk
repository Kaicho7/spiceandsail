              <option value="2" data-surcharge="0" selected>2 Passengers (Private Minivan)</option>
              <option value="3" data-surcharge="0">3 Passengers (Private Minivan)</option>
              <option value="4" data-surcharge="0">4 Passengers (Private Minivan)</option>
              <option value="5" data-surcharge="20">5 Passengers (VIP HiAce +$20)</option>
              <option value="6" data-surcharge="20">6 Passengers (VIP HiAce +$20)</option>
              <option value="7" data-surcharge="20">7 Passengers (VIP HiAce +$20)</option>
              <option value="8" data-surcharge="20">8 Passengers (VIP HiAce +$20)</option>
              <option value="9" data-surcharge="45">9–14 Passengers (Private Coaster +$45)</option>
