          </div>

          <!-- Travel Date -->
          <div>
            <label style="display: block; font-weight: 700; font-size: 0.9rem; color: #0C1A24; margin-bottom: 0.5rem;">📅 Travel Date</label>
            <input type="date" id="calc-date" style="width: 100%; padding: 0.75rem 1rem; border: 1.5px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: 0.95rem; color: #1e293b;">
          </div>

          <!-- Flight Number (Optional) -->
          <div>
            <label style="display: block; font-weight: 700; font-size: 0.9rem; color: #0C1A24; margin-bottom: 0.5rem;">✈️ Flight Number (Optional)</label>
            <input type="text" id="calc-flight" placeholder="e.g. ET815, QR1487" style="width: 100%; padding: 0.75rem 1rem; border: 1.5px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: 0.95rem; color: #1e293b;">
          </div>
        </div>

        <!-- Calculated Output Card -->
        <div style="background: #0C1A24; color: #fff; border-radius: 12px; padding: 1.75rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--dct-gold, #D4AF37); font-weight: 700; display: block; margin-bottom: 0.25rem;">Guaranteed Direct Fare</span>
            <div style="display: flex; align-items: baseline; gap: 0.75rem;">
              <span id="calc-fare-display" style="font-size: 2.5rem; font-weight: 800; color: #ffffff; line-height: 1;">$55</span>
              <span style="color: #94a3b8; font-size: 0.95rem;">USD (Flat per vehicle)</span>
            </div>
            <p id="calc-route-summary" style="margin: 0.5rem 0 0 0; font-size: 0.88rem; color: #cbd5e1;">ZNZ Airport → Nungwi & Kendwa • Standard Private Minivan (1–4 pax)</p>
            <div style="margin-top: 0.5rem; font-size: 0.8rem; color: #34d399;">
              ✓ Estimated OTA Rate: <span id="calc-ota-display" style="text-decoration: line-through; opacity: 0.8;">$85</span> &bull; You save <strong id="calc-savings-display">$30 USD</strong>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem; width: 100%; max-width: 320px;">
            <a id="calc-whatsapp-btn" href="https://wa.me/255672450934?text=Jambo%20Spice%20%26%20Sail%2C%20I%20would%20like%20to%20reserve%20a%20Private%20Airport%20Transfer%20to%20Nungwi%20%26%20Kendwa%20for%20%2455." target="_blank" rel="noopener" class="btn btn-primary" style="background: #25D366; border-color: #25D366; color: #fff; font-weight: 700; padding: 0.85rem 1.25rem; font-size: 0.98rem; text-align: center; border-radius: 8px;">
              💬 Book on WhatsApp Now
            </a>
            <button type="button" class="btn btn-secondary" onclick="window.snsConcierge ? window.snsConcierge.open() : null" style="background: transparent; border: 1px solid rgba(255,255,255,0.3); color: #fff; font-size: 0.85rem; padding: 0.6rem; border-radius: 8px;">
