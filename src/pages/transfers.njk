  <!-- INSTANT TRANSFER CALCULATOR -->
  <section id="transfer-calculator" class="section" style="padding: 3.5rem 1rem; background: #fff;">
    <div class="container" style="max-width: 950px; margin: 0 auto;">
      <div class="section-header reveal" style="text-align: center; margin-bottom: 2.5rem;">
