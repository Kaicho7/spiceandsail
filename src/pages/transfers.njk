      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail!%20I%20would%20like%20to%20book%20a%20scooter%20or%20a%20private%20transfer%20from%20the%20airport." target="_blank" rel="noopener" class="btn btn-primary" style="background: #25D366; border-color: #25D366; color: #fff; font-weight: 600;">💬 Book a ride or a scooter</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding: 3.5rem 1rem; background: #fdfaf5; border-top: 1px solid #f0e8dc;">
    <div class="container">
      <div class="section-header reveal" style="text-align: center; margin-bottom: 2.5rem;">
        <span class="section-tag" style="color: var(--dct-gold, #D4AF37); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">Standardized Tariffs</span>
        <h2 style="font-size: 2.2rem; color: #003853; margin-top: 0.5rem;">Catalogue Planning Ranges for Private Transfers</h2>
        <p class="section-subtitle" style="color: #5c727f; max-width: 700px; margin: 0.5rem auto 0;">Ranges are rendered from our verified service catalogue. All rides include an air-conditioned private minivan, meet &amp; greet, flight delay tracking, and luggage handling. Our team confirms your exact rate.</p>
      </div>

      <div class="cards-grid transfer-grid">
        {% for transfer in transfers %}
          <article class="card transfer-card reveal" style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(12,26,36,0.06); display: flex; flex-direction: column;">
            <div class="card-image" style="position: relative; height: 210px; overflow: hidden;">
              {% set trImg = transfer.image or "white-nissan-elgrand-van-parked-gravel.jpg" %}
              <img src="{{ trImg | cdnFile }}" alt="{{ trImg | canonicalAlt(transfer.title) }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
              <span class="card-badge" style="position: absolute; top: 1rem; left: 1rem; background: #003853; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 50px; text-transform: uppercase;">
                {{ transfer.zone or 'Direct Transfer' }}
              </span>
            </div>
            <div class="card-content" style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
              <h3 class="card-title" style="font-size: 1.25rem; color: #0C1A24; margin-bottom: 0.35rem;">{{ transfer.title }}</h3>
              <p class="card-meta" style="font-size: 0.85rem; color: #64748b; margin-bottom: 1rem;">{{ transfer.route }} &bull; {{ transfer.duration }}</p>
              
              <div class="transfer-includes" style="margin-top: auto; padding-top: 1rem; border-top: 1px solid #edf2f7;">
                <h4 style="font-size: 0.82rem; color: #003853; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Service Inclusions:</h4>
                <ul style="list-style: none; display: grid; gap: 0.35rem; padding: 0;">
                  {% for item in transfer.includes %}
                    <li style="font-size: 0.85rem; color: #475569; display: flex; align-items: flex-start; gap: 0.5rem;">
                      <span style="color: #059669; font-weight: 700;">✓</span> {{ item }}
                    </li>
                  {% endfor %}
                </ul>
              </div>

              <div class="card-footer" style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #edf2f7; padding-top: 1rem; margin-top: 1.25rem;">
                <div>
                  <span style="font-size: 0.75rem; color: #64748b; display: block;">Planning range per private vehicle</span>
                  <span class="card-price" style="font-size: 1.4rem; font-weight: 800; color: #0C1A24;">{% catPrice transfer.slug %}</span>
                </div>
                <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20I%20would%20like%20details%20and%20a%20quote%20for%20{{ transfer.title | urlencode }}." target="_blank" rel="noopener noreferrer" class="sns-card-whatsapp" data-trip-whatsapp aria-label="Ask on WhatsApp about {{ transfer.title }}">
                  Ask on WhatsApp
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- STATUTORY LEVIES & MANDATORY INSURANCE TRANSPARENCY -->
  <section style="background: #0C1A24; color: #fff; padding: 4rem 1.5rem;">
    <div class="container" style="max-width: 1050px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span style="color: var(--dct-gold, #D4AF37); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;">Zero Surprises Upon Arrival</span>
        <h2 style="font-size: 2.2rem; margin-top: 0.5rem; color: #fff;">Zanzibar Travel Levies & Insurance Notice</h2>
        <p style="color: #94a3b8; max-width: 700px; margin: 0.5rem auto 0; font-size: 0.95rem;">All foreign passport holders arriving in Zanzibar must comply with government entry requirements and hotel taxes.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem;">
        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🛡️</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Mandatory Inbound Insurance (ZIC)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Official statutory mandate: Foreign travelers entering Zanzibar must hold official Zanzibar Inbound Travel Insurance from ZIC ($44 adult / $22 child, valid 92 days). Combined Tanzania itineraries entering via mainland first (DAR/JRO) follow mainland first-entry insurance.
          </p>
          <a href="https://inbound.visitzanzibar.go.tz" target="_blank" rel="noopener" style="display: inline-block; margin-top: 0.75rem; color: var(--dct-gold, #D4AF37); font-weight: 600; font-size: 0.85rem; text-decoration: underline;">
            Apply on Official Government Portal (inbound.visitzanzibar.go.tz) →
          </a>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🏨</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Tiered Hotel Infrastructure Levy (ZRA)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            The Zanzibar Revenue Authority (ZRA) levies a statutory accommodation fee per guest/night collected directly at check-in/out: <strong>$5.00</strong> (4–5 star), <strong>$4.00</strong> (2–3 star), <strong>$2.00</strong> (1 star/guesthouses), and <strong>$10.00</strong> for designated small-island and underwater suites.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #94a3b8;">
            ✓ Official statutory municipal tax paid to hotel reception.
          </div>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🚗</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Arrival Meet & Greet Guarantee</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Your assigned private driver waits in the terminal arrivals hall holding an official Spice & Sail nameboard. 60 minutes complimentary delay waiting time included with real-time flight tracking.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #34d399;">
            ✓ Direct WhatsApp coordinate with operations manager.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Script for Transfer Calculator: every range comes from the server /quote endpoint.
       No fares are computed in the browser. -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const pickupEl = document.getElementById('calc-pickup');
    const destEl = document.getElementById('calc-dest');
    const paxEl = document.getElementById('calc-pax');
    const dateEl = document.getElementById('calc-date');
    const flightEl = document.getElementById('calc-flight');
    const fareDisplayEl = document.getElementById('calc-fare-display');
    const routeSummaryEl = document.getElementById('calc-route-summary');
    const waBtn = document.getElementById('calc-whatsapp-btn');

    let quoteRequestId = 0;
    let lastQuoteKey = '';
    let lastFareLabel = 'price on request';
    let lastQuoteReasons = [];

    function localDateString(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return year + '-' + month + '-' + day;
    }

    const today = localDateString(new Date());
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    if (dateEl) {
      dateEl.min = today;
      dateEl.value = localDateString(tomorrow);
    }

    function currentRoute() {
      const option = destEl && destEl.options[destEl.selectedIndex];
      const pickup = pickupEl ? pickupEl.value : 'ZNZ Airport';
      const slug = option ? (option.getAttribute('data-slug') || '') : '';
      const zone = option ? (option.getAttribute('data-zone') || 'Destination') : 'Destination';
      const passengers = paxEl ? Math.max(1, Math.min(50, parseInt(paxEl.value, 10) || 1)) : 2;
      const date = dateEl ? dateEl.value : '';
      const flight = flightEl ? flightEl.value.trim().slice(0, 80) : '';
      const driverLanguage = document.getElementById('calc-driver-lang');
      const language = driverLanguage ? driverLanguage.value : 'English';
      const isAirportOrFerry = pickup.includes('Airport') || pickup.includes('Ferry');
      return {
        pickup: pickup,
        slug: slug,
        zone: zone,
        passengers: passengers,
        date: date,
        flight: flight,
        language: language,
        supported: Boolean(slug && isAirportOrFerry)
      };
    }

    function buildWhatsAppMessage(route, fareLabel) {
      const lang = window.SpiceInternational ? window.SpiceInternational.getLanguage() : 'en';
      const greetings = {
        en: 'Jambo Spice & Sail! I would like to enquire about a private transfer:',
        it: 'Ciao Spice & Sail! Vorrei chiedere un preventivo per un transfer privato:',
        de: 'Hallo Spice & Sail! Ich möchte einen Preis für einen privaten Transfer anfragen:'
      };
      const greeting = greetings[lang] || greetings.en;
      const pickup = route.pickup + (route.flight ? ' (Flight: ' + route.flight + ')' : '');
      const languageNote = route.language !== 'English'
        ? '\n• Driver language requested: ' + route.language + ' (advance request; team confirms availability and any extra cost)'
        : '';
      return greeting + '\n' +
        '• Pickup: ' + pickup + '\n' +
        '• Destination: ' + route.zone + '\n' +
        '• Preferred date: ' + (route.date || 'To be confirmed') + '\n' +
        '• Guests: ' + route.passengers + '\n' +
        '• Verified catalogue result: ' + fareLabel + '\n' +
        'Please confirm availability, the appropriate vehicle and the final quote.' +
        languageNote;
    }

    function updateWhatsAppFallback(route, fareLabel) {
      if (!waBtn) return;
      const message = buildWhatsAppMessage(route, fareLabel);
      waBtn.href = 'https://wa.me/{{ site.contact.whatsapp }}?text=' + encodeURIComponent(message);
    }

    function updateSummary(route, fareLabel, reasons) {
      if (fareDisplayEl) {
        fareDisplayEl.textContent = fareLabel;
        fareDisplayEl.removeAttribute('data-usd-min');
        fareDisplayEl.removeAttribute('data-usd-max');
      }
      if (routeSummaryEl) {
        const note = reasons && reasons.length ? ' — ' + reasons.join(' ') : '';
        routeSummaryEl.textContent = route.pickup + ' → ' + route.zone + ' • ' +
          route.passengers + ' guest(s) • ' + (route.date || 'Date to be confirmed') +
          ' • ' + fareLabel + note + ' Our team confirms the final rate.';
      }
      updateWhatsAppFallback(route, fareLabel);
    }

    function updateCalculator() {
      if (!destEl || !paxEl) return;
      const route = currentRoute();
      const quoteKey = [route.slug, route.pickup, route.passengers, route.date].join('|');

      if (!route.supported) {
        quoteRequestId++;
        lastQuoteKey = quoteKey;
        lastFareLabel = 'price on request';
        lastQuoteReasons = [route.slug
          ? 'This pickup route is not covered by an exact catalogue transfer service.'
          : 'This destination does not yet have a verified catalogue rate.'];
        updateSummary(route, lastFareLabel, lastQuoteReasons);
        return;
      }

      if (quoteKey === lastQuoteKey) {
        updateWhatsAppFallback(route, lastFareLabel);
        return;
      }

      lastQuoteKey = quoteKey;
      const requestId = ++quoteRequestId;
      lastFareLabel = 'Checking verified catalogue range…';
      lastQuoteReasons = [];
      updateSummary(route, lastFareLabel, lastQuoteReasons);

      fetch('/.netlify/functions/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          serviceSlug: route.slug,
          adults: route.passengers,
          children: 0,
          date: route.date || null
        })
      }).then(function (response) {
        if (!response.ok) throw new Error('Catalogue quote request failed');
        return response.json();
      }).then(function (quote) {
        if (requestId !== quoteRequestId) return;
        if (!quote || !quote.status) throw new Error('Catalogue quote response was invalid');

        let displayFare = quote.totalDisplay || 'price on request';
        if (quote.status === 'quoted' && quote.totalLow != null && quote.totalHigh != null && window.SpiceInternational) {
          displayFare = window.SpiceInternational.formatRangeConverted(
            quote.totalLow, quote.totalHigh, window.SpiceInternational.getCurrency()
          );
          if (fareDisplayEl) {
            fareDisplayEl.setAttribute('data-usd-min', quote.totalLow);
            fareDisplayEl.setAttribute('data-usd-max', quote.totalHigh);
          }
        }
        lastFareLabel = displayFare;
        lastQuoteReasons = Array.isArray(quote.reasons) ? quote.reasons : [];
        updateSummary(route, lastFareLabel, lastQuoteReasons);
      }).catch(function () {
        if (requestId !== quoteRequestId) return;
        lastFareLabel = 'price on request';
        lastQuoteReasons = ['Our team will confirm this route and vehicle rate.'];
        updateSummary(route, lastFareLabel, lastQuoteReasons);
      });
    }

    const conciergeButton = document.getElementById('calc-concierge-btn');
    if (conciergeButton) {
      conciergeButton.addEventListener('click', function () {
        if (window.snsConcierge && typeof window.snsConcierge.open === 'function') {
          window.snsConcierge.open();
        }
      });
    }

    if (waBtn) {
      waBtn.addEventListener('click', function (event) {
        const route = currentRoute();
        if (!route.supported || !window.snsConcierge || typeof window.snsConcierge.openBooking !== 'function') {
          // Keep the prepared WhatsApp URL as a direct human-contact fallback
          // for unlisted routes or when the concierge is unavailable.
          return;
        }
        event.preventDefault();
        const notes = [
          'Destination: ' + route.zone,
          route.flight ? 'Flight number: ' + route.flight : '',
          route.language !== 'English' ? 'Driver language requested: ' + route.language + ' (team to confirm availability and any extra cost)' : ''
        ].filter(Boolean).join('\n');
        const options = {
          serviceSlug: route.slug,
          date: route.date,
          guests: route.passengers,
          pickup: route.pickup + (route.flight ? ' — Flight: ' + route.flight : ''),
          notes: notes
        };
        const originalText = waBtn.textContent;
        waBtn.textContent = 'Opening Island Concierge…';
        waBtn.setAttribute('aria-busy', 'true');
        Promise.resolve(window.snsConcierge.openBooking(options)).then(function (opened) {
          if (!opened) {
            waBtn.setAttribute('aria-label', 'Concierge could not open; use the WhatsApp fallback link');
          }
        }).catch(function () {
          // The concierge presents its own safe error and the WhatsApp fallback remains available.
        }).then(function () {
          waBtn.textContent = originalText;
          waBtn.removeAttribute('aria-busy');
        });
      });
    }

    if (pickupEl) pickupEl.addEventListener('change', updateCalculator);
    if (destEl) destEl.addEventListener('change', updateCalculator);
    if (paxEl) paxEl.addEventListener('input', updateCalculator);
    if (dateEl) dateEl.addEventListener('change', updateCalculator);
    if (flightEl) flightEl.addEventListener('input', updateCalculator);
    const driverLanguageEl = document.getElementById('calc-driver-lang');
    if (driverLanguageEl) driverLanguageEl.addEventListener('change', updateCalculator);

    window.addEventListener('spice:currency-changed', updateCalculator);
    window.addEventListener('spice:language-changed', updateCalculator);

    updateCalculator();
  });
  </script>
</main>

