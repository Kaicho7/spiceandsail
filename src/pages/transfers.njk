              <option value="Paje / Jambiani Beach">🌊 Paje / Jambiani Beach</option>
              <option value="Matemwe / Kiwengwa Beach">🌴 Matemwe / Kiwengwa Beach</option>
            </select>
          </div>

          <!-- Destination Zone -->
          <div>
            <label style="display: block; font-weight: 700; font-size: 0.9rem; color: #0C1A24; margin-bottom: 0.5rem;">🏁 Destination Hotel / Zone</label>
            <select id="calc-dest" style="width: 100%; padding: 0.75rem 1rem; border: 1.5px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: 0.95rem; color: #1e293b;">
