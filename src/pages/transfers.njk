  <!-- TRANSFER ROUTES GRID -->
  <section class="section" style="padding: 3.5rem 1rem; background: #fdfaf5; border-top: 1px solid #f0e8dc;">
    <div class="container">
      <div class="section-header reveal" style="text-align: center; margin-bottom: 2.5rem;">
        <span class="section-tag" style="color: var(--dct-gold, #D4AF37); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">Standardized Tariffs</span>
        <h2 style="font-size: 2.2rem; color: #003853; margin-top: 0.5rem;">Verified Flat Transfer Rates</h2>
        <p class="section-subtitle" style="color: #5c727f; max-width: 700px; margin: 0.5rem auto 0;">Standardized private vehicle rates. All rides include air-conditioned tourist minivan, flight delay tracking, and luggage handling.</p>
      </div>

      <div class="cards-grid transfer-grid">
        {% for transfer in transfers %}
          <article class="card transfer-card reveal" style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(12,26,36,0.06); display: flex; flex-direction: column;">
            <div class="card-image" style="position: relative; height: 210px; overflow: hidden;">
              {% set trImg = transfer.image or "white-nissan-elgrand-van-parked-gravel.jpg" %}
              <img src="{{ trImg | cdnFile }}" alt="{{ trImg | canonicalAlt(transfer.title) }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
              <span class="card-badge" style="position: absolute; top: 1rem; left: 1rem; background: #003853; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 50px; text-transform: uppercase;">
                {{ transfer.zone or 'Direct Transfer' }}
              </span>
            </div>
            <div class="card-content" style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
              <h3 class="card-title" style="font-size: 1.25rem; color: #0C1A24; margin-bottom: 0.35rem;">{{ transfer.title }}</h3>
              <p class="card-meta" style="font-size: 0.85rem; color: #64748b; margin-bottom: 1rem;">{{ transfer.route }} &bull; {{ transfer.duration }}</p>
              
              <div class="transfer-includes" style="margin-top: auto; padding-top: 1rem; border-top: 1px solid #edf2f7;">
                <h4 style="font-size: 0.82rem; color: #003853; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Service Inclusions:</h4>
                <ul style="list-style: none; display: grid; gap: 0.35rem; padding: 0;">
                  {% for item in transfer.includes %}
                    <li style="font-size: 0.85rem; color: #475569; display: flex; align-items: flex-start; gap: 0.5rem;">
                      <span style="color: #059669; font-weight: 700;">✓</span> {{ item }}
                    </li>
                  {% endfor %}
                </ul>
              </div>

              <div class="card-footer" style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #edf2f7; padding-top: 1rem; margin-top: 1.25rem;">
                <div>
                  <span style="font-size: 0.75rem; color: #64748b; display: block;">Flat vehicle rate</span>
                  <span class="card-price" style="font-size: 1.4rem; font-weight: 800; color: #0C1A24;">{{ transfer.price.display }}</span>
                </div>
                <a href="https://wa.me/255672450934?text=Jambo%20Spice%20%26%20Sail%2C%20I%20would%20like%20to%20book%20the%20{{ transfer.title | urlencode }}%20({{ transfer.price.display }})." target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="background: #25D366; border-color: #25D366; color: #fff; font-weight: 700;">
                  💬 WhatsApp
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- STATUTORY LEVIES & MANDATORY INSURANCE TRANSPARENCY -->
  <section style="background: #0C1A24; color: #fff; padding: 4rem 1.5rem;">
    <div class="container" style="max-width: 1050px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span style="color: var(--dct-gold, #D4AF37); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;">Zero Surprises Upon Arrival</span>
        <h2 style="font-size: 2.2rem; margin-top: 0.5rem; color: #fff;">Zanzibar Travel Levies & Insurance Notice</h2>
        <p style="color: #94a3b8; max-width: 700px; margin: 0.5rem auto 0; font-size: 0.95rem;">All foreign passport holders arriving in Zanzibar must comply with government entry requirements and hotel taxes.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem;">
        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🛡️</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Mandatory Inbound Insurance (ZIC)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Mandatory government rule: All foreign travelers to Zanzibar must hold official Zanzibar Inbound Travel Insurance from the Zanzibar Insurance Corporation ($44 per adult / $22 per child). Valid up to 92 days.
          </p>
          <a href="https://visitzanzibar.go.tz" target="_blank" rel="noopener" style="display: inline-block; margin-top: 0.75rem; color: var(--dct-gold, #D4AF37); font-weight: 600; font-size: 0.85rem; text-decoration: underline;">
            Apply on Official Portal (visitzanzibar.go.tz) →
          </a>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🏨</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">ZRB Hotel Infrastructure Levy</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            The Zanzibar Revenue Board (ZRB) collects an infrastructure development fee of <strong>$4.00 to $5.00 USD per person per night</strong> at all registered hotels and resorts. Paid directly at hotel reception upon check-in/out.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #94a3b8;">
            ✓ Universal statutory tax across all island hotels.
          </div>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🚗</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Arrival Meet & Greet Guarantee</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Your assigned private driver waits in the terminal arrivals hall holding an official Spice & Sail nameboard. 60 minutes complimentary delay waiting time included with real-time flight tracking.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #34d399;">
            ✓ Direct WhatsApp coordinate with operations manager.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Script for Transfer Calculator -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const pickupEl = document.getElementById('calc-pickup');
    const destEl = document.getElementById('calc-dest');
    const paxEl = document.getElementById('calc-pax');
    const dateEl = document.getElementById('calc-date');
    const flightEl = document.getElementById('calc-flight');
    const fareDisplayEl = document.getElementById('calc-fare-display');
    const routeSummaryEl = document.getElementById('calc-route-summary');
    const otaDisplayEl = document.getElementById('calc-ota-display');
    const savingsDisplayEl = document.getElementById('calc-savings-display');
    const waBtn = document.getElementById('calc-whatsapp-btn');

    // Default today's date + 1 day
    const tmrw = new Date();
    tmrw.setDate(tmrw.getDate() + 1);
    if (dateEl) {
      dateEl.value = tmrw.toISOString().split('T')[0];
    }

    function updateCalculator() {
      if (!destEl || !paxEl) return;
      const selectedOption = destEl.options[destEl.selectedIndex];
      const baseFare = parseInt(selectedOption.getAttribute('data-fare'), 10) || 55;
      const destZone = selectedOption.getAttribute('data-zone') || 'Destination';

      const selectedPaxOption = paxEl.options[paxEl.selectedIndex];
      const surcharge = parseInt(selectedPaxOption.getAttribute('data-surcharge'), 10) || 0;
      const paxCount = paxEl.value;

      const totalFare = baseFare + surcharge;
      const otaEstimate = Math.round(totalFare * 1.45);
      const savings = otaEstimate - totalFare;

      const pickup = pickupEl ? pickupEl.value : 'ZNZ Airport';
      const dateVal = dateEl && dateEl.value ? dateEl.value : 'Upcoming date';
      const flightVal = flightEl && flightEl.value.trim() ? ' (' + flightEl.value.trim() + ')' : '';

      fareDisplayEl.textContent = '$' + totalFare;
      otaDisplayEl.textContent = '$' + otaEstimate;
      savingsDisplayEl.textContent = '$' + savings + ' USD';
      routeSummaryEl.textContent = pickup + ' → ' + destZone + ' • ' + paxCount + ' Passenger(s)' + (surcharge > 0 ? ' (Extended Vehicle)' : ' (Private Minivan)');

      const waMessage = 'Jambo Spice & Sail! I would like to reserve a Private Transfer:\n' +
        '• Pickup: ' + pickup + flightVal + '\n' +
        '• Destination: ' + destZone + '\n' +
        '• Date: ' + dateVal + '\n' +
        '• Passengers: ' + paxCount + ' pax\n' +
        '• Rate: $' + totalFare + ' USD Fixed\n' +
        'Please confirm driver availability.';

      waBtn.href = 'https://wa.me/255672450934?text=' + encodeURIComponent(waMessage);
    }

    if (pickupEl) pickupEl.addEventListener('change', updateCalculator);
    if (destEl) destEl.addEventListener('change', updateCalculator);
    if (paxEl) paxEl.addEventListener('change', updateCalculator);
    if (dateEl) dateEl.addEventListener('change', updateCalculator);
    if (flightEl) flightEl.addEventListener('input', updateCalculator);

    updateCalculator();
  });
  </script>
</main>

