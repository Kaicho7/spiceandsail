        <a href="https://wa.me/{{ site.contact.whatsapp }}?text=I'm planning a Zanzibar trip and want to time it with the migration" target="_blank" rel="noopener" class="btn btn-accent btn-lg">Custom Itinerary</a>
        <a href="/safaris/" class="btn btn-outline btn-lg">Explore Safari Options</a>
      </div>
    </div>
  </div>
  <div class="supplementary-cta">
    {% if page.intent %}
      <p>Still have questions about timing your Zanzibar trip? <span class="whatsapp-cta">{{ page.intent.cta_text }}</span></p>
    {% else %}
      <p>Still have questions? <span class="whatsapp-cta">{{ default.intent.cta_text }}</span></p>
    {% endif %}
  </div>
</section>

  {% include "footer.njk" %}
</main>