            <div class="card-footer" style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #edf2f7; padding-top: 1rem; margin-top: 1.25rem;">
              <div>
                <span style="font-size: 0.75rem; color: #64748b; display: block;">Fascia di pianificazione per veicolo privato</span>
                <span class="card-price" style="font-size: 1.4rem; font-weight: 800; color: #0C1A24;">{% catPrice transfer.slug %}</span>
              </div>
              <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Ciao%20Spice%20%26%20Sail%2C%20vorrei%20prenotare%20il%20{{ transfer.title | urlencode }}." target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="background: #25D366; border-color: #25D366; color: #fff; font-weight: 700;">
                💬 WhatsApp
              </a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
      <div style="margin-top: 2.5rem; display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/it/trasferimenti/aeroporto-stone-town/" class="btn btn-outline btn-sm">ZNZ → Stone Town</a>
        <a href="/it/trasferimenti/aeroporto-paje/" class="btn btn-outline btn-sm">ZNZ → Paje &amp; Jambiani</a>
        <a href="/it/trasferimenti/aeroporto-nungwi/" class="btn btn-outline btn-sm">ZNZ → Nungwi &amp; Kendwa</a>
      </div>
    </div>
  </section>

  <section style="background: #0C1A24; color: #fff; padding: 4rem 1.5rem;">
    <div class="container" style="max-width: 1050px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span style="color: var(--dct-gold, #D4AF37); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;">Zero Sorprese all'Arrivo</span>
        <h2 style="font-size: 2.2rem; margin-top: 0.5rem; color: #fff;">Imposte di Viaggio Zanzibar & Avviso Assicurazione</h2>
        <p style="color: #94a3b8; max-width: 700px; margin: 0.5rem auto 0; font-size: 0.95rem;">Tutti i titolari di passaporto estero in arrivo a Zanzibar devono rispettare i requisiti governativi d'ingresso e le tasse alberghiere.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem;">
        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🛡️</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Assicurazione Ingresso Obbligatoria (ZIC)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Obbligo governativo ufficiale: I viaggiatori esteri in ingresso a Zanzibar devono avere l'Assicurazione Viaggio Ingresso Ufficiale Zanzibar da ZIC ($44 adulto / $22 bambino, validità 92 giorni). Itinerari Tanzania combinati con ingresso prima via terraferma (DAR/JRO) seguono l'assicurazione terraferma primo ingresso.
          </p>
          <a href="https://inbound.visitzanzibar.go.tz" target="_blank" rel="noopener" style="display: inline-block; margin-top: 0.75rem; color: var(--dct-gold, #D4AF37); font-weight: 600; font-size: 0.85rem; text-decoration: underline;">
            Richiedi sul Portale Governativo Ufficiale (inbound.visitzanzibar.go.tz) →
          </a>
        </div>
        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🏨</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Imposta Infrastrutture Alberghiere a Scaglioni (ZRA)</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            L'Autorità Entrate Zanzibar (ZRA) applica una tassa di soggiorno obbligatoria per ospite/notte riscossa direttamente al check-in/out: <strong>$5.00</strong> (4–5 stelle), <strong>$4.00</strong> (2–3 stelle), <strong>$2.00</strong> (1 stella/guesthouse), e <strong>$10.00</strong> per suite piccole isole e subacquee designate.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #94a3b8;">
            ✓ Tassa comunale ufficiale pagata alla reception dell'hotel.
          </div>
        </div>
        <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.5rem;">
          <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">🚗</div>
          <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 0.5rem;">Garanzia Meet & Greet all'Arrivo</h3>
          <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
            Il tuo autista assegnato ti aspetta nell'atrio arrivi terminal con cartello nominativo ufficiale Spice & Sail. 60 minuti attesa gratuita per ritardo incluso con tracciamento voli in tempo reale.
          </p>
          <div style="margin-top: 0.75rem; font-size: 0.82rem; color: #34d399;">
            ✓ Coordinamento WhatsApp diretto con responsabile operativo.
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const pickupEl = document.getElementById('calc-pickup');
    const destEl = document.getElementById('calc-dest');
    const paxEl = document.getElementById('calc-pax');
    const dateEl = document.getElementById('calc-date');
    const flightEl = document.getElementById('calc-flight');
    const fareDisplayEl = document.getElementById('calc-fare-display');
    const routeSummaryEl = document.getElementById('calc-route-summary');
    const waBtn = document.getElementById('calc-whatsapp-btn');

    let quoteRequestId = 0;
    let lastQuoteKey = '';
    let lastFareLabel = 'su richiesta';
    let lastQuoteReasons = [];
    let lastQuote = null;

    function formatQuoteDisplay(quote) {
      if (quote && quote.status === 'quoted' && quote.totalLow != null && quote.totalHigh != null && window.SpiceInternational) {
        return window.SpiceInternational.formatRangeConverted(
          quote.totalLow, quote.totalHigh, window.SpiceInternational.getCurrency()
        );
      }
      return quote && quote.totalDisplay ? quote.totalDisplay : 'su richiesta';
    }

    function localDateString(date) {
      return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
    }

    const today = localDateString(new Date());
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    if (dateEl) {
      dateEl.min = today;
      dateEl.value = localDateString(tomorrow);
    }

    function currentRoute() {
      const option = destEl && destEl.options[destEl.selectedIndex];
      const pickup = pickupEl ? pickupEl.value : 'Aeroporto ZNZ';
      const destVal = destEl ? destEl.value : '';
      let slug = option ? (option.getAttribute('data-slug') || '') : '';
      const zone = option ? (option.getAttribute('data-zone') || 'Destinazione') : 'Destinazione';
      const passengers = paxEl ? Math.max(1, Math.min(50, parseInt(paxEl.value, 10) || 1)) : 2;
      const date = dateEl ? dateEl.value : '';
      const flight = flightEl ? flightEl.value.trim().slice(0, 80) : '';
      const driverLanguage = document.getElementById('calc-driver-lang');
      const language = driverLanguage ? driverLanguage.value : 'English';
      const isAirportOrFerry = pickup.includes('Airport') || pickup.includes('Ferry');
      const isStoneTownHotel = pickup.includes('Stone Town Hotel');
      if (isStoneTownHotel && destVal === 'nungwi-kendwa') slug = 'stone-town-to-nungwi';
      return {
        pickup, slug, zone, passengers, date, flight, language,
        supported: Boolean(slug && (isAirportOrFerry || (isStoneTownHotel && destVal === 'nungwi-kendwa')))
      };
    }

    function updateSummary(route, fareLabel, reasons, quote) {
      if (fareDisplayEl) {
        fareDisplayEl.textContent = fareLabel;
        fareDisplayEl.removeAttribute('data-usd-min');
        fareDisplayEl.removeAttribute('data-usd-max');
        if (quote && quote.status === 'quoted' && quote.totalLow != null && quote.totalHigh != null) {
          fareDisplayEl.setAttribute('data-usd-min', quote.totalLow);
          fareDisplayEl.setAttribute('data-usd-max', quote.totalHigh);
        }
      }
      const currCodeEl = document.getElementById('calc-curr-code');
      if (currCodeEl && window.SpiceInternational) currCodeEl.textContent = window.SpiceInternational.getCurrency();
      if (routeSummaryEl) {
        const note = reasons && reasons.length ? ' — ' + reasons.join(' ') : '';
        routeSummaryEl.textContent = route.pickup + ' → ' + route.zone + ' • ' + route.passengers + ' ospite/i • ' + (route.date || 'Data da confermare') + ' • ' + fareLabel + note + ' Il nostro team conferma la tariffa finale.';
      }
      if (waBtn) {
        const langNote = route.language !== 'English' ? '\n• Lingua autista richiesta: ' + route.language : '';
        const msg = 'Ciao Spice & Sail! Vorrei chiedere disponibilità per un transfer privato:\n• Prelievo: ' + route.pickup + (route.flight ? ' (Volo: ' + route.flight + ')' : '') + '\n• Destinazione: ' + route.zone + '\n• Data: ' + (route.date || 'Da confermare') + '\n• Ospiti: ' + route.passengers + '\n• Tariffa catalogo: ' + fareLabel + langNote + '\nPrego confermare disponibilità e tariffa finale.';
        waBtn.href = 'https://wa.me/{{ site.contact.whatsapp }}?text=' + encodeURIComponent(msg);
      }
    }

    function updateCalculator() {
      if (!destEl || !paxEl) return;
      const route = currentRoute();
      const quoteKey = [route.slug, route.pickup, route.passengers, route.date].join('|');
      if (!route.supported) {
        quoteRequestId++;
        lastQuoteKey = quoteKey;
        lastQuote = null;
        lastFareLabel = 'tariffa su richiesta';
        lastQuoteReasons = ['Tratta punto-a-punto personalizzata — il nostro team conferma veicolo e tariffa direttamente.'];
        updateSummary(route, lastFareLabel, lastQuoteReasons);
        return;
      }
      if (quoteKey === lastQuoteKey) {
        if (lastQuote) {
          lastFareLabel = formatQuoteDisplay(lastQuote);
          updateSummary(route, lastFareLabel, lastQuoteReasons, lastQuote);
        }
        return;
      }
      lastQuoteKey = quoteKey;
      const requestId = ++quoteRequestId;
      lastQuote = null;
      lastFareLabel = 'Verifica tariffa catalogo…';
      lastQuoteReasons = [];
      updateSummary(route, lastFareLabel, lastQuoteReasons);

      fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serviceSlug: route.slug, adults: route.passengers, children: 0, date: route.date || null })
      }).then(function (r) { if (!r.ok) throw new Error('Quote failed'); return r.json(); }).then(function (quote) {
        if (requestId !== quoteRequestId || !quote || !quote.status) return;
        lastQuote = quote;
        lastFareLabel = formatQuoteDisplay(quote);
        lastQuoteReasons = Array.isArray(quote.reasons) ? quote.reasons : [];
        updateSummary(route, lastFareLabel, lastQuoteReasons, lastQuote);
      }).catch(function () {
        if (requestId !== quoteRequestId) return;
        lastQuote = null;
        lastFareLabel = 'tariffa su richiesta';
        lastQuoteReasons = ['Il nostro team confermerà direttamente questa tratta.'];
        updateSummary(route, lastFareLabel, lastQuoteReasons);
      });
    }

    const conciergeButton = document.getElementById('calc-concierge-btn');
    if (conciergeButton) {
      conciergeButton.addEventListener('click', function () {
        if (window.snsConcierge && typeof window.snsConcierge.open === 'function') window.snsConcierge.open();
      });
    }

    if (waBtn) {
      waBtn.addEventListener('click', function (event) {
        if (paxEl && !paxEl.reportValidity()) { event.preventDefault(); return; }
        if (dateEl && !dateEl.reportValidity()) { event.preventDefault(); return; }
        const route = currentRoute();
        if (!route.supported || !window.snsConcierge || typeof window.snsConcierge.openBooking !== 'function') return;
        event.preventDefault();
        const notes = ['Destinazione: ' + route.zone, route.flight ? 'Numero volo: ' + route.flight : '', route.language !== 'English' ? 'Lingua autista richiesta: ' + route.language : ''].filter(Boolean).join('\n');
        const originalText = waBtn.textContent;
        waBtn.textContent = 'Apertura Island Concierge…';
        if (typeof window.snsTrack === 'function') {
          window.snsTrack('concierge_booking_opened', { service_slug: route.slug, funnel_stage: 'transfers', source: 'transfer_calculator_it' });
        }
        Promise.resolve(window.snsConcierge.openBooking({
          serviceSlug: route.slug,
          date: route.date,
          guests: route.passengers,
          pickup: route.pickup + (route.flight ? ' — Volo: ' + route.flight : ''),
          notes: notes
        })).finally(function () { waBtn.textContent = originalText; });
      });
    }

    const driverLangEl = document.getElementById('calc-driver-lang');
    if (pickupEl) pickupEl.addEventListener('change', updateCalculator);
    if (destEl) destEl.addEventListener('change', updateCalculator);
    if (paxEl) paxEl.addEventListener('input', updateCalculator);
    if (dateEl) dateEl.addEventListener('change', updateCalculator);
    if (flightEl) flightEl.addEventListener('input', updateCalculator);
    if (driverLangEl) driverLangEl.addEventListener('change', updateCalculator);
    window.addEventListener('spice:currency-changed', updateCalculator);
    window.addEventListener('spice:language-changed', updateCalculator);
    updateCalculator();
  });
  </script>
</main>

