---
title: "The One Resort Zanzibar — Half Board from $136/room/night | Spice & Sail"
description: "The One Resort Zanzibar on the South Coast. 40 rooms & villas, Half Board & All Inclusive seasonal rates from $136/room/night. Verified rack rates (15% discount), airport transfers, Safari Blue included. Book direct via WhatsApp."
permalink: "/hotels/the-one-resort-zanzibar/"
hotel_slug: "the-one-resort-zanzibar"
eleventyComputed:
  title: "The One Resort Zanzibar — Half Board from ${{ 'the-one-resort-zanzibar' | getFromRate }}/room/night | Spice & Sail"
  description: "The One Resort Zanzibar on the South Coast. 40 rooms & villas, Half Board & All Inclusive seasonal rates from ${{ 'the-one-resort-zanzibar' | getFromRate }}/room/night. Verified rack rates (15% discount), airport transfers, Safari Blue included. Book direct via WhatsApp."
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="" id="main-content">
  <section class="hotel-hero" style="background: linear-gradient(135deg, var(--dct-palm) 0%, var(--dct-ocean) 100%);">
    <div class="hotel-hero-content">
      {% set featured = page.inputPath | featuredImage %}
      {% set cdnSrc = page.inputPath | cdnImage %}
      <img src="{{ cdnSrc }}" alt="The One Resort Zanzibar aerial view with pool and ocean" class="hotel-hero-image" loading="eager" fetchpriority="high">
      <span class="card-badge badge-hotel">Resort</span>
      <span class="swahili-kicker"><strong>South Coast</strong><span>Luxury resort</span></span>
      <h1>The One Resort Zanzibar</h1>
      <p class="hotel-meta">Makunduchi, South Coast · Half Board / All Inclusive · From ${{ "the-one-resort-zanzibar" | getFromRate }}/room/night (Green Season, 2 adults)</p>
      <div class="hotel-price-box">
        <span class="price-label">From</span>
        <span class="price-amount">${{ "the-one-resort-zanzibar" | getFromRate }}</span>
        <span class="price-note">per room, per night (Half Board, Green Season, 2 adults)</span>
      </div>
    </div>
  </section>

  {% set hotel_slug = "the-one-resort-zanzibar" %}
  {% set hotel = hotel_slug | rateFor %}
  {% include "hotel-rate-table.njk" %}

  <section class="hotel-bundles" aria-labelledby="bundles-heading">
    <h2 id="bundles-heading" class="section-title">Popular Packages (add bundles as options)</h2>
    <div class="bundle-grid">
      {% set pkg = hotel_slug | bundleFor %}
      {% if pkg %}
      <article class="bundle-card">
        <h3>{{ pkg.name }}</h3>
        <p class="bundle-meta">{{ pkg.nights }} nights · From ${{ pkg.perPersonMin }}–${{ pkg.perPersonMax }} per person</p>
        <ul class="bundle-includes">
          {% for item in pkg.includes %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
        <div class="bundle-cta">
          <button type="button" data-sns-booking-open data-service-slug="{{ pkg.id }}" class="btn btn-primary">Check Dates & Quote</button>
          <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Hi%20Spice%20and%20Sail!%20I%20would%20like%20to%20book%20{{ pkg.name | urlencode }}%20for%202%20guests." target="_blank" rel="noopener" class="btn btn-secondary">WhatsApp</a>
        </div>
      </article>
      {% endif %}
    </div>
  </section>

  <section class="hotel-transfers" aria-labelledby="transfers-heading">
    <h2 id="transfers-heading" class="section-title">Airport Transfers (per vehicle)</h2>
    <p class="transfer-note">Rates are <strong>per private vehicle, one-way</strong> (up to 6 passengers). Round-trip available.</p>
    <div class="table-wrapper">
      <table class="rate-table">
        <thead>
          <tr>
            <th>Route</th>
            <th>Sedan (1–3 pax)</th>
            <th>Van (4–6 pax)</th>
          </tr>
        </thead>
        <tbody>
          {% set trf = hotelPublicRates.transferRatesPerVehicle %}
          {% for t in trf %}
            {% if t.slug == 'airport-transfer-znz-to-stone-town' or t.slug == 'airport-transfer-znz-to-pajejambiani' or t.slug == 'airport-transfer-znz-to-nungwikendwa' or t.slug == 'airport-transfer-znz-to-kizimkazi' %}
          <tr>
            <td>{{ t.route }}</td>
            <td>${{ t.vehicles[0].min }}</td>
            <td>${{ t.vehicles[1].min }}</td>
          </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="transfer-note">Transfer rates are per private vehicle. Our team confirms your vehicle and pickup before you pay anything.</p>
  </section>

  <section class="hotel-cta" aria-labelledby="cta-heading">
    <h2 id="cta-heading" class="section-title">Ready to Book?</h2>
    <p>Get a personalized quote with exact dates, transfers, and tours. Our team confirms exact room type, dates, and pickup window.</p>
    <div class="cta-buttons">
      <button type="button" data-sns-booking-open data-service-slug="pkg-south-coast-family" class="btn btn-primary">Check Dates & Quote</button>
      <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Hi%20Spice%20and%20Sail!%20I%20would%20like%20to%20book%20The%20One%20Resort%20Zanzibar%20for%202%20guests." target="_blank" rel="noopener" class="btn btn-secondary">Chat on WhatsApp</a>
    </div>
  </section>

</main>

{% include "footer.njk" %}