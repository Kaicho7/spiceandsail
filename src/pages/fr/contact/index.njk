{% include "seo.njk" %}
{% include "header.njk" %}

<main class="" id="main-content">
  <header class="page-header">
    <h1>Contact Spice and Sail Zanzibar</h1>
    <p>WhatsApp-first booking. We respond within 2 hours during business hours (EAT, UTC+3).</p>
  </header>

  <section class="section section-gradient">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Get in Touch</span>
        <h2>Fastest Way to Reach Us</span>
        <p class="section-subtitle">Choose your preferred channel — we'll get back to you within 2 hours during business hours.</p>
      </div>
      <div class="area-quick-picks" style="max-width: 900px; margin: 0 auto;">
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M56 8C59.3137 8 62 10.6863 62 14V50C62 53.3137 59.3137 56 56 56H8C4.68629 56 2 53.3137 2 50V14C2 10.6863 4.68629 8 8 8H16V6C16 2.68629 18.6863 0 22 0H42C45.3137 0 48 2.68629 48 6V8H56ZM18 6H42V8H18V6ZM56 14V50H8V14H16L22 20H42L48 14H56ZM32 40C36.4183 40 40 36.4183 40 32C40 27.5817 36.4183 24 32 24C27.5817 24 24 27.5817 24 32C24 36.4183 27.5817 40 32 40ZM32 26C29.2386 26 27 28.2386 27 31C27 33.7614 29.2386 36 32 36C34.7614 36 37 33.7614 37 31C37 28.2386 34.7614 26 32 26Z"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>WhatsApp (Fastest)</h3>
            <p>Message us directly for quotes, bookings, and questions. Pre-filled message ready.</p>
            <a href="https://wa.me/{{ site.contact.whatsapp }}?text=I'd%20like%20to%20book%20a%20Zanzibar%20tour" target="_blank" rel="noopener" class="btn btn-accent">Open WhatsApp Chat</a>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, var(--dct-ocean) 0%, var(--dct-palm) 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M8 22C8 18.6863 10.6863 16 14 16H50C53.3137 16 56 18.6863 56 22V42C56 45.3137 53.3137 48 50 48H14C10.6863 48 8 45.3137 8 42V22ZM8 24V42H14L24 32H40L50 42H56V24H8Z" fill="white" xmlns="http://www.w3.org/2000/svg"/><path d="M8 24V42H14L24 32H40L50 42H56V24H8Z" fill="white" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>WhatsApp for Documents</h3>
            <p>For formal inquiries, group bookings, or documentation requests, send them over WhatsApp — we reply in minutes.</span>
            <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Hello%20Spice%20and%20Sail%2C%20I%20have%20a%20booking%20enquiry" target="_blank" rel="noopener" class="btn btn-primary">Message us on WhatsApp</a>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, #b8860b 0%, var(--dct-spice) 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="20" stroke="white" stroke-width="2.5"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Phone / SMS</h3>
            <p>Call or text during business hours (9 AM – 5 PM EAT).</span>
            <a href="tel:{{ site.contact.phone }}" class="btn btn-secondary">{{ site.contact.phone_display }}</a>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, #4285f4 0%, #34a853 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M20 40v-8h4v8h8v-4h-8v-4h4v-8h-4v8H12v4h8zm-8 12v8h8v-4H12v-4h4v-8H8v8h4zm16 12v8h8v-4H12v-4h4v-8H8v8h4zm4-4v8h8v-4h-8v-4H12v8h4zm-4 8v8H20v-4h-4V8h4V8z" fill="white" xmlns="http://www.w3.org/2000/svg"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Email</h3>
            <p>For formal inquiries and documentation, email us directly. We reply within 2 hours during business hours.</span>
            <a href="mailto:{{ site.contact.email }}" class="btn btn-secondary">{{ site.contact.email }}</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Or Use This Form</span>
        <h2>Send a Message Here</span>
        <p class="section-subtitle">Fill out the form and we'll reply via WhatsApp or email within 2 hours during business hours.</p>
      </div>
      <div style="max-width: 700px; margin: 0 auto;">
        <form class="contact-form" name="booking-inquiry" method="POST" action="/api/lead">
          <input type="hidden" name="form-name" value="booking-inquiry">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="email">Email Address <small style="font-weight: 400; color: #64748b;">(required — we'll also message you on WhatsApp if you provide a number below)</label>
              <input type="email" id="email" name="email" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="phone">WhatsApp / Mobile Number <small style="font-weight: 400; color: #64748b;">(optional — speeds up our reply)</label>
              <input type="tel" id="phone" name="phone" placeholder="e.g. +44 7700 900077, +1 555 123 4567, +255...">
            </div>
            <div class="form-group">
              <label for="travel-dates">Travel Dates</label>
              <input type="text" id="travel-dates" name="travel_dates" placeholder="e.g., 15–22 July 2026">
            </div>
          </div>
          <div class="form-group">
            <label for="interests">What Interests You? *</label>
            <select id="interests" name="interests" required>
              <option value="">Select..</option>
              <option value="tours">Day Tours (Stone Town, Spice, Marine, Nature)</option>
              <option value="transfers">Airport Transfers</option>
              <option value="packages">Multi-Day Packages</option>
              <option value="safaris">Mainland Safaris</option>
              <option value="custom">Custom Itinerary</option>
              <option value="other">Other / Not Sure</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Details, Special Requests, Questions</label>
            <textarea id="message" name="message" rows="5" placeholder="Any special occasions, dietary needs, accessibility requirements, specific hotels or activities..."></textarea>
          </div>
          <div class="form-group consent-group" style="margin: 1.25rem 0;">
            <label class="checkbox-label" style="display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.88rem; color: #4e5d66; cursor: pointer;">
              <input type="checkbox" name="consent_contact" id="consent_contact" required style="margin-top: 0.2rem;">
              <span>I agree to be contacted via WhatsApp/email regarding my travel inquiry in accordance with the <a href="/privacy/" target="_blank" rel="noopener" style="color: var(--dct-ocean); text-decoration: underline;">Privacy Notice</a>. *</span>
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-full">Send Inquiry</button>
          <p class="form-note" style="text-align: center;">We'll reply via WhatsApp or email within 2 hours during business hours.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Operations & Office</span>
        <h2>Our Location & Dispatch Hub</span>
        <p>Main Operations & Depot: {{ site.address.display }}.</p>
        <p style="margin-top: 0.5rem; font-size: 0.9rem; color: var(--dct-text-muted);">Serving all island pickups across Stone Town, Airport, Nungwi, Kendwa, Paje, Jambiani, and Matemwe.</p>
        <p style="margin-top: 0.5rem;">
          <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener" style="color: var(--dct-ocean); font-weight: 500;">WhatsApp: {{ site.contact.whatsapp_display }}</a><br>
          <span style="color: var(--dct-ocean); font-weight: 500;">WhatsApp-first — replies within 2 hours during business hours</span>
        </p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-content reveal">
      <h2>Quick Links to Popular Pages</h2>
      <div class="quick-link-grid">
        <a href="/tours/" class="quick-link">Browse All Tours</a>
        <a href="/transfers/" class="quick-link">Airport Transfers</a>
        <a href="/packages/" class="quick-link">Multi-Day Packages</a>
        <a href="/hotels/" class="quick-link">Where to Stay</a>
        <a href="/areas/" class="quick-link">Explore by Zone</a>
        <a href="/about/" class="quick-link">About Us</a>
      </div>
    </div>
  </section>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('form[name="booking-inquiry"]');
    if (form) {
      form.addEventListener('submit', function(e) {
        var emailVal = (document.getElementById('email') ? document.getElementById('email').value : '').trim();
        if (!emailVal) {
          e.preventDefault();
          alert('Please enter an email address so our team can reply.');
          if (document.getElementById('email')) document.getElementById('email').focus();
        }
      });
    }
  });
  </script>
