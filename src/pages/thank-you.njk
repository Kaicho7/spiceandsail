---
title: Thank you — Spice and Sail Zanzibar
permalink: "/thank-you/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="page-thank-you">
  <section class="section-thank-you">
    <div class="container-center">
      <h1>Thank you!</h1>
      <p>We've received your request and will get back to you shortly via WhatsApp.</p>

      <div class="confirmation-details">
        <p id="ref-box" style="display:none; font-size: 1.15rem; background: #e8f4f8; padding: 0.85rem 1rem; border-radius: 8px; border: 1.5px solid #005f8a; color: #003853; margin-bottom: 1rem;">
          <strong>Enquiry Reference:</strong> <span id="enquiry-ref" style="font-family: monospace; font-weight: 800; color: #005f8a;"></span>
        </p>
        <p><strong>Fastest reply:</strong> message us on WhatsApp — usually within minutes, 08:00–18:00 EAT (Mon–Sat).</p>
        <p><strong>Submitted:</strong> <span id="thank-you-time"></span></p>
      </div>

      <div style="margin-top: 1.5rem;">
        <a id="wa-continue-btn" href="https://wa.me/255672450934" class="btn btn-accent btn-block" target="_blank" rel="noopener">
          💬 Continue to WhatsApp with Reference
        </a>
      </div>

      <!-- Review Request Container -->
      <div id="review-request-container"></div>

      <script>
        document.getElementById('thank-you-time').textContent =
          new Date().toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
        try {
          var params = new URLSearchParams(window.location.search);
          var ref = params.get('ref');
          if (ref) {
            var refEl = document.getElementById('enquiry-ref');
            var refBox = document.getElementById('ref-box');
            var waBtn = document.getElementById('wa-continue-btn');
            if (refEl) refEl.textContent = ref;
            if (refBox) refBox.style.display = 'block';
            if (waBtn) waBtn.href = 'https://wa.me/255672450934?text=' + encodeURIComponent('Hello Spice and Sail! Following up on my enquiry reference: ' + ref);
          }
        } catch (e) {}
      </script>

      <!-- Review Capture Script -->
      <script src="/js/review-capture.js"></script>
      <script>
        // Trigger review capture if this is a post-service thank you
        // Check for service completion params
        (function() {
          var params = new URLSearchParams(window.location.search);
          var serviceCompleted = params.get('completed') === 'true';
          var serviceType = params.get('serviceType');
          var serviceName = params.get('serviceName');
          var bookingRef = params.get('ref') || params.get('bookingRef');
          var phone = params.get('phone');

          if (serviceCompleted && serviceType && serviceName && phone) {
            // Trigger review capture
            if (window.SpiceReviewCapture) {
              window.SpiceReviewCapture.trigger({
                phone: phone,
                serviceType: serviceType,
                serviceName: serviceName,
                bookingRef: bookingRef,
                language: document.documentElement.lang || 'en'
              });
            }
          }
        })();
      </script>
    </div>
  </section>
</main>

{% include "footer.njk" %}