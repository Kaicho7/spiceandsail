<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
{% set computedTitle = title or (page.fileSlug | replace("-", " ") | capitalize) %}
{% set hasBrand = computedTitle and (computedTitle.includes("Spice and Sail") or computedTitle.includes("Spice & Sail")) %}
{% set pageTitle = computedTitle if hasBrand else (computedTitle + " | Spice and Sail") %}
{% set pageDesc = description | default("Book " + computedTitle + " with Spice and Sail in Zanzibar. Clear pricing, verified local guides, and fast WhatsApp booking.") %}

{% set ogImage = og_image or (page.inputPath | rawImage) %}

{% set SITE_URL = site.url | replace("http://", "https://") %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{% if metaRobots or previewRobots %}<meta name="robots" content="{{ previewRobots or metaRobots }}">{% endif %}
<link rel="canonical" href="{{ SITE_URL }}{{ page.url }}">
{% if preload_image %}<link rel="preload" as="image" href="{{ preload_image | cdnFile }}" fetchpriority="high">{% endif %}
<meta property="og:type" content="website">
<meta property="og:url" content="{{ SITE_URL }}{{ page.url }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:image" content="{{ SITE_URL }}{{ ogImage }}">
<meta property="og:site_name" content="Spice and Sail Zanzibar">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ SITE_URL }}{{ ogImage }}">

<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
<link rel="icon" type="image/svg+xml" sizes="16x16" href="/images/favicon-16x16.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{% if alternate_it or alternate_de or alternate_en %}
{% set langCode = lang or 'en' %}
{% set currentUrl = SITE_URL + page.url %}
{% if langCode == 'en' %}
<link rel="alternate" hreflang="en" href="{{ currentUrl }}">
{% if alternate_it %}<link rel="alternate" hreflang="it" href="{{ alternate_it }}">{% endif %}
{% if alternate_de %}<link rel="alternate" hreflang="de" href="{{ alternate_de }}">{% endif %}
{% elif langCode == 'it' %}
<link rel="alternate" hreflang="it" href="{{ currentUrl }}">
{% if alternate_en %}<link rel="alternate" hreflang="en" href="{{ alternate_en }}">{% endif %}
{% if alternate_de %}<link rel="alternate" hreflang="de" href="{{ alternate_de }}">{% endif %}
{% elif langCode == 'de' %}
<link rel="alternate" hreflang="de" href="{{ currentUrl }}">
{% if alternate_en %}<link rel="alternate" hreflang="en" href="{{ alternate_en }}">{% endif %}
{% if alternate_it %}<link rel="alternate" hreflang="it" href="{{ alternate_it }}">{% endif %}
{% endif %}
<link rel="alternate" hreflang="x-default" href="{{ SITE_URL }}/">
{% endif %}

{% if analytics and analytics.measurementId %}
{# GA4 config uses requestIdleCallback in /js/sns-ga4-config.js #}
<script src="/js/sns-ga4-config.js" data-sns-ga4-config data-measurement-id="{{ analytics.measurementId }}" defer></script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["TourOperator", "TravelAgency", "LocalBusiness"],
      "@id": "{{ SITE_URL | safe }}/#organization",
      "name": "Spice and Sail Zanzibar",
      "url": "{{ SITE_URL | safe }}",
      "logo": "{{ SITE_URL | safe }}/images/logo.webp",
      "image": "{{ SITE_URL | safe }}/images/sunset-dhow-cruise-zanzibar-stone-town.jpg",
      "description": "{{ site.description }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.address.street }}",
        "addressLocality": "{{ site.address.city }}",
        "addressRegion": "{{ site.address.region }}",
        "postalCode": "{{ site.address.postal_code }}",
        "addressCountry": "{{ site.address.country_code }}"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -6.0682,
        "longitude": 39.2495
      },
      "telephone": "{{ site.contact.phone_display }}",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "{{ site.hours.open }}",
          "closes": "{{ site.hours.close }}"
        }
      ],
      "sameAs": [
        "https://wa.me/{{ site.contact.whatsapp }}"{% if site.social and site.social.google_maps %},
        "{{ site.social.google_maps }}"{% endif %}{% if site.social and site.social.instagram %},
        "{{ site.social.instagram }}"{% endif %}{% if site.social and site.social.tiktok %},
        "{{ site.social.tiktok }}"{% endif %}{% if site.social and site.social.youtube %},
        "{{ site.social.youtube }}"{% endif %}{% if site.social and site.social.twitter %},
        "{{ site.social.twitter }}"{% endif %}{% if site.social and site.social.facebook %},
        "{{ site.social.facebook }}"{% endif %}{% if site.social and site.social.tripadvisor %},
        "{{ site.social.tripadvisor }}"{% endif %}{% if site.social and site.social.trustpilot %},
        "{{ site.social.trustpilot }}"{% endif %}
      ],
      "priceRange": "$$",
      "currenciesAccepted": "USD, TZS",
      "paymentAccepted": "Cash (USD, TZS), Mobile Money (M-Pesa, Airtel Money, Tigo Pesa), Card (via DPO/Pesapal payment link)",
      "areaServed": [
        "Zanzibar",
        "Stone Town",
        "Nungwi",
        "Kendwa",
        "Paje",
        "Jambiani",
        "Kiwengwa",
        "Matemwe",
        "Pongwe",
        "Michamvi",
        "Bwejuu",
        "Dongwe",
        "Kizimkazi",
        "Fumba",
        "Pemba Island"
      ],
      "hasMap": "https://goo.gl/maps/SpiceAndSailZanzibar"
    }{% if tour_slug %},
    {
      "@type": "Product",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#product",
      "name": "{{ pageTitle }}",
      "description": "{{ pageDesc }}",
      "image": "{{ SITE_URL | safe }}{{ ogImage }}",
      "brand": {
        "@type": "Brand",
        "name": "Spice and Sail Zanzibar"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": {{ tour_slug | catMin }},
        "highPrice": {{ tour_slug | catMax }},
        "offerCount": "1",
        "url": "{{ SITE_URL | safe }}{{ page.url }}",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "TouristTrip",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#touristtrip",
      "name": "{{ pageTitle }}",
      "description": "{{ pageDesc }}",
      "image": "{{ SITE_URL | safe }}{{ ogImage }}",
      "touristType": "Leisure",
      "itinerary": {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@type": "TouristAttraction",
              "name": "{{ pageTitle }}",
              "description": "{{ pageDesc }}"
            }
          }
        ]
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": {{ tour_slug | catMin }},
        "highPrice": {{ tour_slug | catMax }},
        "url": "{{ SITE_URL | safe }}{{ page.url }}",
        "availability": "https://schema.org/InStock"
      }
    }{% endif %}{% if page.url != '/' and not tour_slug %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ SITE_URL | safe }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ pageTitle }}"
        }
      ]
    }{% endif %}{% if page.url == '/' %},
    {
      "@type": "FAQPage",
      "@id": "{{ SITE_URL | safe }}/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need to pay a deposit for Zanzibar airport transfers?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Spice & Sail offers zero advance deposit on all airport transfers. You reserve your private minivan with flight tracking and 60 minutes free waiting time, then pay your driver directly upon hotel arrival in USD, EUR, or TZS (cash or card)." }
        },
        {
          "@type": "Question",
          "name": "Are marine park fees included in tour prices?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — Menai Bay ($10) and Mnemba ($25) conservation fees are included in all our tour prices. No surprise cash demands on the beach." }
        },
        {
          "@type": "Question",
          "name": "What happens if the weather is bad on my tour date?",
          "acceptedAnswer": { "@type": "Answer", "text": "100% Captain's Weather Guarantee: if Zanzibar Maritime Authority advisories prevent safe sailing, you receive an immediate 100% refund or priority reschedule at no extra cost." }
        },
        {
          "@type": "Question",
          "name": "Do you have guides who speak Italian, German, French, or Polish?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — dedicated Italian, German, French, or Polish-speaking Zanzibari guides are available upon advance request for an additional fee. Standard tours include English/Swahili guides." }
        },
        {
          "@type": "Question",
          "name": "How much cheaper is booking direct vs Viator or GetYourGuide?",
          "acceptedAnswer": { "@type": "Answer", "text": "Booking direct with Spice & Sail typically saves 20–35% compared to Viator/GetYourGuide, as we have no platform commissions. All marine fees and guide costs are included in our published rates." }
        }
      ]
    }{% endif %}{% if tour_slug and (page.url.includes('/tours/') or page.url.includes('/experiences/') or page.url.includes('/packages/')) %},
    {
      "@type": "FAQPage",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is included in the {{ pageTitle }} price?",
          "acceptedAnswer": { "@type": "Answer", "text": "{{ pageDesc }} All marine park fees, guide fees, and transfers where applicable are included. Our team confirms the final quote with exact inclusions before booking." }
        },
        {
          "@type": "Question",
          "name": "Can I customize the {{ pageTitle }} duration or itinerary?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — most tours are flexible. Morning or afternoon departures, add visits, extend to full-day. WhatsApp us to discuss your preferences." }
        },
        {
          "@type": "Question",
          "name": "What is the deposit policy for {{ pageTitle }}?",
          "acceptedAnswer": { "@type": "Answer", "text": "{% set depositPct = tour_slug | catDepositPercent %}{% if depositPct > 0 %}{{ depositPct }}% deposit secures your booking (boat captain, fuel, fresh seafood for marine tours; flights & park permits for safaris). Balance due before departure.{% else %}Zero advance deposit — pay on arrival (transfers) or on the day (land tours).{% endif %}" }
        },
        {
          "@type": "Question",
          "name": "What if the weather is bad on my tour date?",
          "acceptedAnswer": { "@type": "Answer", "text": "100% Captain's Weather Guarantee for all marine excursions: if Zanzibar Maritime Authority advisories prevent safe sailing, you receive an immediate 100% refund or priority reschedule at no extra cost." }
        }
      ]
    }{% endif %}
  ]
}
</script>
</head>