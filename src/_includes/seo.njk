<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% set computedTitle = title or (page.fileSlug | replace("-", " ") | capitalize) %}
{% set hasBrand = computedTitle and (computedTitle.includes("Spice and Sail") or computedTitle.includes("Spice & Sail")) %}
{% set pageTitle = computedTitle if hasBrand else (computedTitle + " | Spice and Sail") %}
{% set pageDesc = description | default("Book " + computedTitle + " with Spice and Sail in Zanzibar. Clear pricing, verified local guides, and fast WhatsApp booking.") %}

{% set ogImage = og_image or (page.inputPath | rawImage) %}

{% set SITE_URL = site.url | replace("http://", "https://") %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{% if metaRobots %}<meta name="robots" content="{{ metaRobots }}">{% endif %}
<link rel="canonical" href="{{ SITE_URL }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ SITE_URL }}{{ page.url }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:image" content="{{ SITE_URL }}{{ ogImage }}">
<meta property="og:site_name" content="Spice and Sail Zanzibar">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ SITE_URL }}{{ ogImage }}">

<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
<link rel="icon" type="image/svg+xml" sizes="16x16" href="/images/favicon-16x16.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

{% if site.ga_measurement_id %}
<!-- Google tag (gtag.js) - GA4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_measurement_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.ga_measurement_id }}', {
    page_path: window.location.pathname,
    cookie_flags: 'SameSite=None;Secure'
  });
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["TourOperator", "TravelAgency", "LocalBusiness"],
      "@id": "{{ SITE_URL | safe }}/#organization",
      "name": "Spice and Sail Zanzibar",
      "url": "{{ SITE_URL | safe }}",
      "logo": "{{ SITE_URL | safe }}/images/logo.png",
      "image": "{{ SITE_URL | safe }}/images/dhow-sail-at-sunset-ocean.jpg",
      "description": "Zanzibar tour operator and transfer specialist based in Mbuzini & Stone Town — authentic tours, airport transfers and multi-day packages. WhatsApp-first booking with transparent pricing including marine park fees.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Near Mbuzini Hospital, Mbuzini, Magharibi District",
        "addressLocality": "Zanzibar",
        "postalCode": "71208",
        "addressCountry": "TZ"
      },
      "telephone": "+255 672 450 934",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "-6.1659",
        "longitude": "39.2026"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "sameAs": [
        "https://wa.me/255672450934"
      ],
      "priceRange": "$$",
      "currenciesAccepted": "USD, TZS",
      "paymentAccepted": "Cash, Mobile Money, Bank Transfer, Card (via link)"
    }{% if tour_slug %},
    {
      "@type": "Product",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#product",
      "name": "{{ pageTitle }}",
      "description": "{{ pageDesc }}",
      "image": "{{ SITE_URL | safe }}{{ ogImage }}",
      "brand": {
        "@type": "Brand",
        "name": "Spice and Sail Zanzibar"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": {{ tour_slug | catMin }},
        "highPrice": {{ tour_slug | catMax }},
        "offerCount": "1",
        "availability": "https://schema.org/InStock",
        "url": "{{ SITE_URL | safe }}{{ page.url }}"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ SITE_URL | safe }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tours",
          "item": "{{ SITE_URL | safe }}/tours/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ pageTitle }}"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I book and when do I pay for this tour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Booking is fast and flexible via WhatsApp (+255 672 450 934). Send us your preferred dates, hotel location, and group size. Zero upfront deposit required for standard day tours — pay upon meeting your guide in cash (USD or TZS) or via secure card payment link."
          }
        },
        {
          "@type": "Question",
          "name": "Are government marine conservation and park fees included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! All official Zanzibar government conservation fees and permits are fully included upfront in our planning rates with zero surprise cash demands at the boat or park gates."
          }
        },
        {
          "@type": "Question",
          "name": "What is the cancellation and bad weather policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide 100% free cancellation or rescheduling up to 24 hours prior to tour departure, as well as complimentary rescheduling or a full refund if marine weather makes boat crossings unsafe."
          }
        },
        {
          "@type": "Question",
          "name": "Is hotel pickup and drop-off available across Zanzibar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, private air-conditioned vehicle transfers can be bundled door-to-door from any hotel across Stone Town, Nungwi, Kendwa, Paje, Jambiani, Kiwengwa, and Matemwe."
          }
        }
      ]
    }{% elseif page.url != '/' %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ SITE_URL | safe }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ pageTitle }}"
        }
      ]
    }{% endif %}
  ]
}
</script>
