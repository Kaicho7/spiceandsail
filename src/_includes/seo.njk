<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
{% set computedTitle = title or (page.fileSlug | replace("-", " ") | capitalize) %}
{% set hasBrand = computedTitle and (computedTitle.includes("Spice and Sail") or computedTitle.includes("Spice & Sail")) %}
{% set pageTitle = computedTitle if hasBrand else (computedTitle + " | Spice and Sail") %}
{% set pageDesc = description | default("Book " + computedTitle + " with Spice and Sail in Zanzibar. Clear pricing, verified local guides, and fast WhatsApp booking.") %}

{% set ogImage = og_image or (page.inputPath | rawImage) %}

{% set SITE_URL = site.url | replace("http://", "https://") %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{% if metaRobots %}<meta name="robots" content="{{ metaRobots }}">{% endif %}
<link rel="canonical" href="{{ SITE_URL }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ SITE_URL }}{{ page.url }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:image" content="{{ SITE_URL }}{{ ogImage }}">
<meta property="og:site_name" content="Spice and Sail Zanzibar">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ SITE_URL }}{{ ogImage }}">

<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
<link rel="icon" type="image/svg+xml" sizes="16x16" href="/images/favicon-16x16.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{% if alternate_it or alternate_de or alternate_en %}
{% set langCode = lang or 'en' %}
{% set currentUrl = SITE_URL + page.url %}
{% if langCode == 'en' %}
<link rel="alternate" hreflang="en" href="{{ currentUrl }}">
{% if alternate_it %}<link rel="alternate" hreflang="it" href="{{ alternate_it }}">{% endif %}
{% if alternate_de %}<link rel="alternate" hreflang="de" href="{{ alternate_de }}">{% endif %}
{% elif langCode == 'it' %}
<link rel="alternate" hreflang="it" href="{{ currentUrl }}">
{% if alternate_en %}<link rel="alternate" hreflang="en" href="{{ alternate_en }}">{% endif %}
{% if alternate_de %}<link rel="alternate" hreflang="de" href="{{ alternate_de }}">{% endif %}
{% elif langCode == 'de' %}
<link rel="alternate" hreflang="de" href="{{ currentUrl }}">
{% if alternate_en %}<link rel="alternate" hreflang="en" href="{{ alternate_en }}">{% endif %}
{% if alternate_it %}<link rel="alternate" hreflang="it" href="{{ alternate_it }}">{% endif %}
{% endif %}
<link rel="alternate" hreflang="x-default" href="{{ SITE_URL }}/">
{% endif %}

{% if site.ga_measurement_id %}
<!-- Google tag (gtag.js) - GA4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_measurement_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.ga_measurement_id }}', {
    page_path: window.location.pathname,
    cookie_flags: 'SameSite=None;Secure'
  });
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["TourOperator", "TravelAgency", "LocalBusiness"],
      "@id": "{{ SITE_URL | safe }}/#organization",
      "name": "Spice and Sail Zanzibar",
      "url": "{{ SITE_URL | safe }}",
      "logo": "{{ SITE_URL | safe }}/images/logo.png",
      "image": "{{ SITE_URL | safe }}/images/sunset-dhow-cruise-zanzibar-stone-town.jpg",
      "description": "Zanzibar tour operator and transfer specialist based in Mbuzini & Stone Town — authentic tours, airport transfers and multi-day packages. WhatsApp-first booking with transparent pricing including marine park fees.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.address.street }}",
        "addressLocality": "{{ site.address.city }}",
        "addressRegion": "{{ site.address.region }}",
        "postalCode": "{{ site.address.postal_code }}",
        "addressCountry": "{{ site.address.country_code }}"
      },
      "telephone": "{{ site.contact.phone_display }}",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "-6.1659",
        "longitude": "39.2026"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "{{ site.hours.open }}",
          "closes": "{{ site.hours.close }}"
        }
      ],
      "sameAs": [
        "https://wa.me/{{ site.contact.whatsapp }}"{% if site.social and site.social.instagram %},
        "{{ site.social.instagram }}"{% endif %}{% if site.social and site.social.tiktok %},
        "{{ site.social.tiktok }}"{% endif %}{% if site.social and site.social.youtube %},
        "{{ site.social.youtube }}"{% endif %}{% if site.social and site.social.twitter %},
        "{{ site.social.twitter }}"{% endif %}{% if site.social and site.social.facebook %},
        "{{ site.social.facebook }}"{% endif %}{% if site.social and site.social.tripadvisor %},
        "{{ site.social.tripadvisor }}"{% endif %}
      ],
      "priceRange": "$$",
      "currenciesAccepted": "USD, TZS",
      "paymentAccepted": "Cash, Mobile Money, Bank Transfer, Card (via link)"
    }{% if tour_slug %},
    {
      "@type": "Product",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#product",
      "name": "{{ pageTitle }}",
      "description": "{{ pageDesc }}",
      "image": "{{ SITE_URL | safe }}{{ ogImage }}",
      "brand": {
        "@type": "Brand",
        "name": "Spice and Sail Zanzibar"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": {{ tour_slug | catMin }},
        "highPrice": {{ tour_slug | catMax }},
        "offerCount": "1",
        "url": "{{ SITE_URL | safe }}{{ page.url }}"
      }
    },
    {
      "@type": "TouristTrip",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#touristtrip",
      "name": "{{ pageTitle }}",
      "description": "{{ pageDesc }}",
      "image": "{{ SITE_URL | safe }}{{ ogImage }}",
      "touristType": "Leisure",
      "itinerary": {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@type": "TouristAttraction",
              "name": "{{ pageTitle }}",
              "description": "{{ pageDesc }}"
            }
          }
        ]
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": {{ tour_slug | catMin }},
        "highPrice": {{ tour_slug | catMax }},
        "url": "{{ SITE_URL | safe }}{{ page.url }}"
      }
    }{% endif %}{% if page.url != '/' and not tour_slug %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ SITE_URL | safe }}{{ page.url }}#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ SITE_URL | safe }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ pageTitle }}"
        }
      ]
    }{% endif %}
  ]
}
</script>
</head>