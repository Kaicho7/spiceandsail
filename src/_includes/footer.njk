<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
      <a href="/" class="footer-wordmark">Spice <em>&amp;</em> Sail</a>
      <p>Local Zanzibar tours, transfers and travel planning. WhatsApp-first enquiries, with details and final quotes confirmed by our team.</p>
      <p class="footer-location">{{ site.address.short }}</p>
      {% if site.social and (site.social.instagram or site.social.tiktok or site.social.youtube or site.social.facebook or site.social.tripadvisor) %}
      <div class="footer-social" aria-label="Social media channels">
        {% if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>{% endif %}
        {% if site.social.tiktok %}<a href="{{ site.social.tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a>{% endif %}
        {% if site.social.youtube %}<a href="{{ site.social.youtube }}" target="_blank" rel="noopener noreferrer">YouTube</a>{% endif %}
        {% if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>{% endif %}
        {% if site.social.tripadvisor %}<a href="{{ site.social.tripadvisor }}" target="_blank" rel="noopener noreferrer">Tripadvisor</a>{% endif %}
      </div>
      {% endif %}
    </div>
    <div class="footer-col">
      <h2 class="footer-col-title">Bahari <span>Sea &amp; experiences</span></h2>
      <ul>
        <li><a href="/tours/">Zanzibar tours</a></li>
        <li><a href="/experiences/">Island experiences</a></li>
        <li><a href="/safaris/">Mainland safaris</a></li>
        <li><a href="/packages/">Holiday packages</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-col-title">Usafiri <span>Getting around</span></h2>
      <ul>
        <li><a href="/transfers/">Airport transfers</a></li>
        <li><a href="/transfers/airport-to-nungwi/">Airport to Nungwi</a></li>
        <li><a href="/areas/">Explore Zanzibar areas</a></li>
        <li><a href="/travel-guide/">Travel guide</a></li>
      </ul>
    </div>
    <div class="footer-col footer-contact">
      <h2 class="footer-col-title">{{ "footer_talk_with_team" | t(lang) }}</h2>
      <a href="tel:{{ site.contact.phone }}">Call {{ site.contact.phone_display }}</a>
      <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer" onclick="window.dataLayer.push({'event': 'whatsapp_click', 'page_path': '{{ page.path }}', 'label': 'Footer WhatsApp'});">WhatsApp {{ site.contact.whatsapp_display }}</a>
      {% if site.contact and site.contact.email %}<a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}
      <p>{{ site.hours.days }} · {{ site.hours.open }}–{{ site.hours.close }} EAT</p>
      {% if site.social and site.social.google_maps %}<a href="{{ site.social.google_maps }}" target="_blank" rel="noopener noreferrer">{{ "footer_find_google_maps" | t(lang) }}</a>{% endif %}
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Spice &amp; Sail Zanzibar. All rights reserved.</p>
    <nav aria-label="Legal">
      <a href="/privacy/">{{ "footer_privacy" | t(lang) }}</a>
      <a href="/terms/">{{ "footer_terms" | t(lang) }}</a>
      <a href="/cancellation/">{{ "footer_cancellation" | t(lang) }}</a>
    </nav>
  </div>
</footer>
{% include "concierge-widget.njk" %}

<!-- Sticky Trust Bar (Mobile) -->
<div class="sns-trust-bar" id="snsTrustBar" aria-label="Trust signals">
  <div class="sns-trust-bar__inner">
    <div class="sns-trust-bar__badges" role="list" aria-label="Trust guarantees">
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">🛡️</span>{{ "footer_0_deposit" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">💎</span>{{ "footer_marine_fees" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">🌤️</span>{{ "footer_weather_guarantee" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">🗣️</span>{{ "footer_multilingual_guides" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">💰</span>{{ "footer_viator_less" | t(lang) }}</span>
    </div>
    <div class="sns-trust-bar__cta">
      <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20I%27d%20like%20to%20book%20a%20Zanzibar%20tour" target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-sm">{{ "footer_chat_whatsapp" | t(lang) }}</a>
      <a href="/tours/" class="btn btn-outline btn-sm">{{ "footer_browse_tours" | t(lang) }}</a>
    </div>
  </div>
</div>

<script src="/js/sns-trust-bar.js" defer></script>

</body>
</html>
