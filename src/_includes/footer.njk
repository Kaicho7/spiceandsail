<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
      <a href="/" class="footer-wordmark">Spice <em>&amp;</em> Sail</a>
      <p>Local Zanzibar tours, transfers and travel planning. WhatsApp-first enquiries, with details and final quotes confirmed by our team.</p>
      <p class="footer-location">{{ site.address.short }}</p>
      {% if site.social and (site.social.instagram or site.social.tiktok or site.social.youtube or site.social.facebook or site.social.tripadvisor) %}
      <div class="footer-social" aria-label="Social media">
        {% if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>{% endif %}
        {% if site.social.tiktok %}<a href="{{ site.social.tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a>{% endif %}
        {% if site.social.youtube %}<a href="{{ site.social.youtube }}" target="_blank" rel="noopener noreferrer">YouTube</a>{% endif %}
        {% if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>{% endif %}
        {% if site.social.tripadvisor %}<a href="{{ site.social.tripadvisor }}" target="_blank" rel="noopener noreferrer">Tripadvisor</a>{% endif %}
      </div>
      {% endif %}
    </div>
    <div class="footer-col">
      <h2 class="footer-col-title">Bahari <span>Sea &amp; experiences</span></h2>
      <ul>
        <li><a href="/tours/">Zanzibar tours</a></li>
        <li><a href="/experiences/">Island experiences</a></li>
        <li><a href="/safaris/">Mainland safaris</a></li>
        <li><a href="/packages/">Holiday packages</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-col-title">Usafiri <span>Getting around</span></h2>
      <ul>
        <li><a href="/transfers/">Airport transfers</a></li>
        <li><a href="/transfers/airport-to-nungwi/">Airport to Nungwi</a></li>
        <li><a href="/areas/">Explore Zanzibar areas</a></li>
        <li><a href="/travel-guide/">Travel guide</a></li>
      </ul>
    </div>
    <div class="footer-col footer-contact">
      <h2 class="footer-col-title">Talk with our team</h2>
      <a href="tel:{{ site.contact.phone }}">Call {{ site.contact.phone_display }}</a>
      <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ site.contact.whatsapp_display }}</a>
      {% if site.contact and site.contact.email %}<a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}
      <p>{{ site.hours.days }} · {{ site.hours.open }}–{{ site.hours.close }} EAT</p>
      {% if site.social and site.social.google_maps %}<a href="{{ site.social.google_maps }}" target="_blank" rel="noopener noreferrer">Find us on Google Maps ↗</a>{% endif %}
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Spice &amp; Sail Zanzibar. All rights reserved.</p>
    <nav aria-label="Legal">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/cancellation/">Cancellation</a>
    </nav>
  </div>
</footer>
{% include "concierge-widget.njk" %}
</body>
</html>
