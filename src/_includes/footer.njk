<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
      <a href="{{ 'home' | navUrl(lang) }}" class="footer-wordmark">Spice <em>&amp;</em> Sail</a>
      <p>{{ "footer_tagline" | t(lang) }}</p>
      <p class="footer-location">{{ site.address.short }}</p>
      {% if site.social and (site.social.instagram or site.social.tiktok or site.social.youtube or site.social.facebook or site.social.tripadvisor) %}
      <div class="footer-social" aria-label="Social media channels">
        {% if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer">{{ "footer_instagram" | t(lang) }}</a>{% endif %}
        {% if site.social.tiktok %}<a href="{{ site.social.tiktok }}" target="_blank" rel="noopener noreferrer">{{ "footer_tiktok" | t(lang) }}</a>{% endif %}
        {% if site.social.youtube %}<a href="{{ site.social.youtube }}" target="_blank" rel="noopener noreferrer">{{ "footer_youtube" | t(lang) }}</a>{% endif %}
        {% if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer">{{ "footer_facebook" | t(lang) }}</a>{% endif %}
        {% if site.social.tripadvisor %}<a href="{{ site.social.tripadvisor }}" target="_blank" rel="noopener noreferrer">{{ "footer_tripadvisor" | t(lang) }}</a>{% endif %}
      </div>
      {% endif %}
    </div>
    <div class="footer-col">
      <h2 class="footer-col-title">{{ "footer_bahari" | t(lang) }} <span>{{ "footer_sea_experiences" | t(lang) }}</span></h2>
      <ul>
        <li><a href="{{ 'tours' | navUrl(lang) }}">{{ "footer_zanzibar_tours" | t(lang) }}</a></li>
        <li><a href="{{ 'experiences' | navUrl(lang) }}">{{ "footer_island_experiences" | t(lang) }}</a></li>
        <li><a href="{{ 'safaris' | navUrl(lang) }}">{{ "footer_mainland_safaris" | t(lang) }}</a></li>
        <li><a href="{{ 'packages' | navUrl(lang) }}">{{ "footer_holiday_packages" | t(lang) }}</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-col-title">{{ "footer_usafiri" | t(lang) }} <span>{{ "footer_getting_around" | t(lang) }}</span></h2>
      <ul>
        <li><a href="{{ 'transfers' | navUrl(lang) }}">{{ "footer_airport_transfers" | t(lang) }}</a></li>
        <li><a href="{{ 'nungwi_transfer' | navUrl(lang) }}">{{ "footer_airport_to_nungwi" | t(lang) }}</a></li>
        <li><a href="{{ 'areas' | navUrl(lang) }}">{{ "footer_explore_areas" | t(lang) }}</a></li>
        <li><a href="{{ 'travel_guide' | navUrl(lang) }}">{{ "footer_travel_guide" | t(lang) }}</a></li>
      </ul>
    </div>
    <div class="footer-col footer-contact">
      <h2 class="footer-col-title">{{ "footer_talk_with_team" | t(lang) }}</h2>
      <a href="tel:{{ site.contact.phone }}">{{ "footer_call" | t(lang) }} {{ site.contact.phone_display }}</a>
      <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer" data-sns-event="whatsapp_footer_click" data-sns-funnel="general" data-sns-label="Footer WhatsApp">{{ "footer_whatsapp_label" | t(lang) }} {{ site.contact.whatsapp_display }}</a>
      {% if site.contact and site.contact.email %}{{ site.contact.email }}{% endif %}
      <p>{{ "footer_days_monday_saturday" | t(lang) }} · {{ site.hours.open }}–{{ site.hours.close }} EAT</p>
      {% if site.social and site.social.google_maps %}<a href="{{ site.social.google_maps }}" target="_blank" rel="noopener noreferrer">{{ "footer_find_google_maps" | t(lang) }}</a>{% endif %}
    </div>
  </div>
  <div class="footer-bottom">
    <p>{{ "footer_all_rights_reserved" | t(lang) }}</p>
    <nav aria-label="Legal">
      <a href="{{ 'privacy' | navUrl(lang) }}">{{ "footer_privacy" | t(lang) }}</a>
      <a href="{{ 'terms' | navUrl(lang) }}">{{ "footer_terms" | t(lang) }}</a>
      <a href="{{ 'cancellation' | navUrl(lang) }}">{{ "footer_cancellation" | t(lang) }}</a>
    </nav>
  </div>
</footer>
{% include "concierge-widget.njk" %}

<!-- Sticky Trust Bar (Mobile) -->
<div class="sns-trust-bar" id="snsTrustBar" aria-label="Trust signals">
  <div class="sns-trust-bar__inner">
    <div class="sns-trust-bar__badges" role="list" aria-label="Trust guarantees">
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">🛡️</span>{{ "footer_0_deposit" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">💎</span>{{ "footer_marine_fees" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">🌤️</span>{{ "footer_weather_guarantee" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">🗣️</span>{{ "footer_multilingual_guides" | t(lang) }}</span>
      <span class="sns-trust-badge" role="listitem"><span class="sns-trust-badge__icon" aria-hidden="true">💰</span>{{ "footer_viator_less" | t(lang) }}</span>
    </div>
    <div class="sns-trust-bar__cta">
      <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20I%27d%20like%20to%20book%20a%20Zanzibar%20tour" target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-sm">{{ "footer_chat_whatsapp" | t(lang) }}</a>
      <a href="{{ 'tours' | navUrl(lang) }}" class="btn btn-outline btn-sm">{{ "footer_browse_tours" | t(lang) }}</a>
    </div>
  </div>
</div>

<script src="/js/sns-trust-bar.js" defer></script>
{% if analytics and analytics.measurementId %}
<script src="/js/sns-consent.js" defer></script>
{% endif %}

</body>
</html>
