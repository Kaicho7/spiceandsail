<form class="booking-panel" data-whatsapp-booking data-wa-number="{{ site.contact.whatsapp }}" data-booking-type="{{ bookingType or 'Trip enquiry' }}">
  <div class="booking-panel-intro"><span class="booking-panel-label">WhatsApp enquiry</span><strong>Share the basics</strong><span>Our team will confirm availability and the final price with you.</span></div>
  <label><span>Trip or service</span><input type="text" name="service" value="{{ bookingService or '' }}" placeholder="e.g. Safari Blue or airport transfer" required></label>
  <label><span>Preferred date</span><input type="date" name="date"></label>
  <label><span>Guests</span><input type="number" name="guests" min="1" max="30" value="2" inputmode="numeric" required></label>
  <button type="submit" class="btn btn-whatsapp">Ask on WhatsApp</button>
</form>
