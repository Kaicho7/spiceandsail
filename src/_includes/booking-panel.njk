<form class="booking-panel" data-whatsapp-booking data-wa-number="{{ site.contact.whatsapp }}" data-lang="{{ lang or 'en' }}" data-booking-type="{{ bookingType or 'Trip enquiry' }}">
  <div class="booking-panel-intro">
    {% if lang == "it" %}
    <span class="booking-panel-label">Richiesta WhatsApp</span><strong>Condividi i dettagli</strong><span>Invia la tua richiesta al team su WhatsApp. [placeholder: confirm]</span>
    {% elif lang == "de" %}
    <span class="booking-panel-label">WhatsApp-Anfrage</span><strong>Teile die wichtigsten Angaben</strong><span>Sende deine Anfrage per WhatsApp an unser Team. [placeholder: confirm]</span>
    {% else %}
    <span class="booking-panel-label">WhatsApp enquiry</span><strong>Share the basics</strong><span>Send your request to our team on WhatsApp. [placeholder: confirm]</span>
    {% endif %}
  </div>
  <label>
    {% if lang == "it" %}<span>Tour o servizio</span>{% elif lang == "de" %}<span>Tour oder Service</span>{% else %}<span>Trip or service</span>{% endif %}
    <input type="text" name="service" value="{{ bookingService or '' }}" placeholder="{% if lang == 'it' %}es. Safari Blue o transfer aeroportuale{% elif lang == 'de' %}z. B. Safari Blue oder Flughafentransfer{% else %}e.g. Safari Blue or airport transfer{% endif %}" required>
  </label>
  <label>
    {% if lang == "it" %}<span>Data preferita</span>{% elif lang == "de" %}<span>Wunschdatum</span>{% else %}<span>Preferred date</span>{% endif %}
    <input type="date" name="date">
  </label>
  <label>
    {% if lang == "it" %}<span>Ospiti</span>{% elif lang == "de" %}<span>Gäste</span>{% else %}<span>Guests</span>{% endif %}
    <input type="number" name="guests" min="1" max="30" value="2" inputmode="numeric" required>
  </label>
  <button type="submit" class="btn btn-whatsapp">{% if lang == "it" %}Chiedi su WhatsApp{% elif lang == "de" %}Per WhatsApp anfragen{% else %}Ask on WhatsApp{% endif %}</button>
</form>
