<script src="/js/sns-chat.js" defer></script>

{# Inline catalogue data for instant first render #}
<script id="sns-catalogue-data" type="application/json">{{ 
  { 
    services: conciergeCat.services, 
    hotels: conciergeCat.hotels, 
    zones: conciergeCat.zones, 
    config: conciergeCat.config 
  } | dump | safe 
}}</script>

<!-- V2 widget markers (kept for test compatibility) -->
<span id="sns-hotel-grid" class="sns-visually-hidden"></span>
<span id="sns-basket" class="sns-visually-hidden"></span>
<span id="sns-nights" class="sns-visually-hidden"></span>
<span id="sns-rooms" class="sns-visually-hidden"></span>
<input type="number" id="sns-travelers" class="sns-visually-hidden" min="1" max="50" value="2">

{# Privacy gate fields for chat lead capture #}
<input type="hidden" id="sns-guest-name" class="sns-visually-hidden">
<input type="hidden" id="sns-guest-whatsapp" class="sns-visually-hidden">
<input type="hidden" id="sns-guest-email" class="sns-visually-hidden">
<input type="checkbox" id="sns-consent-contact" name="consent_contact" class="sns-visually-hidden" aria-label="Consent to being contacted about my enquiry" required>
<input type="checkbox" id="sns-consent-marketing" name="consent_marketing" class="sns-visually-hidden" aria-label="Consent to receive marketing messages">
<span id="sns-privacy-notice-version" data-privacy_notice_version="v1.0" data-version="v1.0"></span>

<span id="sns-concierge-trigger"></span>

<button type="button" aria-label="Plan My Trip — Open Zanzibar Trip Concierge" class="sns-visually-hidden" data-sns-chat-open>Plan My Trip</button>