<!-- Concierge Widget - Spice & Sail Zanzibar -->
<div id="sns-concierge-root">
  <!-- Proactive Welcome Callout Bubble -->
  <div id="sns-concierge-callout" class="sns-concierge-callout" hidden aria-live="polite">
    <button type="button" class="sns-callout-close" aria-label="Dismiss message" onclick="window.snsConcierge.dismissCallout(event)">×</button>
    <div class="sns-callout-body" onclick="window.snsConcierge.openChat()">
      <div class="sns-callout-avatar">🛎️</div>
      <div class="sns-callout-text">
        <strong id="sns-callout-heading">Karibu! Need trip advice or a transfer?</strong>
        <p id="sns-callout-sub">Chat instantly or get verified catalogue rates.</p>
      </div>
    </div>
  </div>

  <!-- Trigger Button -->
  <button id="sns-concierge-trigger" class="sns-concierge-btn" aria-label="Open Zanzibar Trip Concierge" onclick="window.snsConcierge.open()">
    <span class="sns-concierge-pulse" aria-hidden="true"></span>
    <span class="sns-concierge-icon" aria-hidden="true">🛎️</span>
    <span class="sns-concierge-label">Plan My Trip</span>
  </button>

  <!-- Concierge Modal Window -->
  <div id="sns-concierge-modal" class="sns-concierge-modal" role="dialog" aria-modal="true" aria-labelledby="concierge-title" hidden aria-live="polite">
    <div class="sns-concierge-backdrop" id="sns-concierge-backdrop" onclick="window.snsConcierge.close()"></div>
    <div class="sns-concierge-panel" role="document">
      <!-- Modal Header -->
      <div class="sns-concierge-header">
        <div class="sns-concierge-title-wrap">
          <h2 id="concierge-title" class="sns-concierge-title">Plan Your Zanzibar Trip</h2>
        </div>
        <button id="sns-concierge-close" class="sns-concierge-close-btn" aria-label="Close concierge" onclick="window.snsConcierge.close()" role="button">×</button>
      </div>

      <!-- Chat panel: the first bot message (sent by the server) contains the privacy notice link -->
      <div id="sns-concierge-chat" class="sns-chat-panel" hidden>
        <div id="sns-chat-messages" class="sns-chat-messages" aria-live="polite"></div>
        <div id="sns-chat-typing" class="sns-chat-typing" hidden>Concierge is typing…</div>
        <div id="sns-chat-quick" class="sns-chat-quick"></div>
        <div class="sns-chat-input-row">
          <input type="text" id="sns-chat-input" class="sns-chat-input" placeholder="Ask about tours, transfers, prices…" aria-label="Message the concierge">
          <button type="button" id="sns-chat-send" class="sns-chat-send-btn">Send</button>
          <button type="button" id="sns-chat-close" class="sns-chat-back-btn">Back to form</button>
        </div>
      </div>

      <!-- Form -->
      <form id="sns-concierge-form" class="sns-concierge-form" novalidate>
        <!-- Honeypot field for bot detection -->
        <input type="text" class="sns-honeypot" name="honeypot" aria-hidden="true" autocomplete="off" tabindex="-1" />

        <!-- Step 1: Service Selection -->
        <div class="sns-form-step active" id="sns-step-1">
          <label class="sns-field-label">What would you like to experience or book?</label>
          <div class="sns-service-grid">
            <!-- Services are populated by JavaScript from the GET /quote catalogue response -->
          </div>
          <button type="button" class="sns-btn-next" onclick="window.snsConcierge.goToStep(2)">Next: Dates &amp; Travelers →</button>
          <button type="button" id="sns-chat-open" class="sns-chat-open-btn">💬 Ask the concierge instead</button>
        </div>

        <!-- Step 2: Travelers & Date -->
        <div class="sns-form-step" id="sns-step-2">
          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-travelers">Number of Travelers</label>
            <select id="sns-travelers" class="sns-input-select" name="travelers">
              <option value="1">1 Traveler (Solo)</option>
              <option value="2" selected>2 Travelers (Couple / Pair)</option>
              <option value="3">3 Travelers</option>
              <option value="4">4 Travelers (Small Family/Group)</option>
              <option value="5">5 Travelers</option>
              <option value="6">6 Travelers (Private Group Minivan)</option>
              <option value="9">9+ Travelers (Large Party)</option>
            </select>
          </div>

          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-date">Preferred Travel Date</label>
            <input type="date" id="sns-date" class="sns-input-date" name="travel_date">
          </div>

          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-location">Pickup Location / Hotel in Zanzibar</label>
            <input type="text" id="sns-location" class="sns-input-text" placeholder="e.g. ZNZ Airport, Riu Palace Nungwi, Paje, Stone Town...">
          </div>

          <div class="sns-step-actions">
            <button type="button" class="sns-btn-back" onclick="window.snsConcierge.goToStep(1)">← Back</button>
            <button type="button" class="sns-btn-next" onclick="window.snsConcierge.goToStep(3)">Next: Planning Range →</button>
          </div>
        </div>

        <!-- Step 3: Planning range (server /quote) & Submit -->
        <div class="sns-form-step" id="sns-step-3">
          <!-- Server-computed planning range -->
          <div class="sns-quote-box">
            <div class="sns-quote-header">
              <span class="sns-quote-title">Planning range (our team confirms final price)</span>
              <span id="sns-quote-amount" class="sns-quote-amount"></span>
            </div>
            <p id="sns-quote-summary" class="sns-quote-summary">Select a service above to see the planning range.</p>
          </div>

          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-guest-name">Your Name</label>
            <input type="text" id="sns-guest-name" class="sns-input-text" placeholder="First & Last Name" required>
          </div>

          <!-- SEPARATE WhatsApp and email fields, at least one required -->
          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-guest-whatsapp">WhatsApp Number (international format)</label>
            <input type="text" id="sns-guest-whatsapp" class="sns-input-text" placeholder="+255672450934" pattern="^\+[1-9]\d{6,14}$" maxlength="15" aria-describedby="whatsapp-help">
            <small id="whatsapp-help">e.g. +255672450934</small>
          </div>

          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-guest-email">Email Address <small style="font-weight:400;">(if no WhatsApp)</small></label>
            <input type="email" id="sns-guest-email" class="sns-input-text" placeholder="example@email.com" aria-describedby="email-help">
            <small id="email-help">we'll never share your email without permission</small>
          </div>

          <!-- TWO consent checkboxes: contact me (required), marketing (unticked by default) -->
          <input type="hidden" name="privacy_notice_version" value="v1.0">
          <div class="sns-field-group">
            <input type="checkbox" id="consent_contact" name="consent_contact" required>
            <label for="consent_contact">Contact me about this request</label>
          </div>

          <div class="sns-field-group">
            <input type="checkbox" id="consent_marketing" name="consent_marketing">
            <label for="consent_marketing">Send me marketing information</label>
          </div>

          <p class="sns-privacy-note" id="sns-privacy-note">
            We store what you share here to answer and handle your request only.
            <a href="/privacy/" target="_blank" rel="noopener">Read the privacy notice</a>.
          </p>

          <div class="sns-field-group">
            <label class="sns-field-label" for="sns-guest-notes">Special Requests or Notes (Optional)</label>
            <textarea id="sns-guest-notes" class="sns-input-textarea" rows="3" placeholder="e.g. Flight QR 1499 landing at 14:30, child seat needed..."></textarea>
          </div>

          <div class="sns-submit-status" id="sns-submit-status" hidden></div>

          <div class="sns-step-actions">
            <button type="button" class="sns-btn-back" onclick="window.snsConcierge.goToStep(2)">← Change Details</button>
            <button type="button" class="sns-btn-whatsapp-direct" id="sns-btn-whatsapp-direct" onclick="window.snsConcierge.openDirectWhatsApp()" style="background:#25D366;color:#fff;border:none;border-radius:6px;padding:0.75rem 1.25rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:0.5rem;">
              <span>💬 Book via WhatsApp</span>
            </button>
            <button type="submit" class="sns-btn-submit" form="sns-concierge-form">Send Request</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
