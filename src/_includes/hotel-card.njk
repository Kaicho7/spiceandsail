<article id="hotel-{{ hotel.slug }}" class="card hotel-card reveal" 
                   data-tier="{{ hotel.tier | lower }}" 
                   data-zone="{{ hotel.zone | lower }}" 
                   data-island="{{ hotel.island | lower }}"
                   data-name="{{ hotel.name | lower }}"
                   style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(12,26,36,0.06); display: flex; flex-direction: column;">
            <div class="card-image" style="position: relative; overflow: hidden; aspect-ratio: 16/10;">
              {% set hImg = hotel | hotelPhoto %}
              <img src="{{ hImg | cdnFile }}" alt="{{ hImg | canonicalAlt(hotel.name) }}" width="800" height="500" sizes="(max-width: 700px) 92vw, (max-width: 1024px) 46vw, 380px" decoding="async" loading="{% if hotelIndex < 2 %}eager{% else %}lazy{% endif %}"{% if hotelIndex == 0 %} fetchpriority="high"{% endif %} style="width: 100%; height: 100%; object-fit: cover;">
              <span class="card-badge badge-{{ hotel.tier | lower | replace('upper-', '') }}" style="position: absolute; top: 12px; left: 12px; z-index: 2; background: #003853; color: #fff; font-size: 0.72rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 50px; text-transform: uppercase;">
                {{ hotel.tier | capitalize }}
              </span>
              {% if hotel.zone %}
                <span class="card-zone-badge" style="position: absolute; bottom: 12px; left: 12px; background: rgba(12,26,36,0.75); color: #fff; font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; backdrop-filter: blur(4px);">
                  📍 {{ hotel.zone }}
                </span>
              {% endif %}
            </div>

            <div class="card-content" style="display: flex; flex-direction: column; justify-content: space-between; flex-grow: 1; padding: 1.25rem;">
              <div>
                <h3 class="card-title" style="margin-top: 0; margin-bottom: 0.35rem; font-size: 1.15rem; color: #003853;">
                  {{ hotel.name }}
                </h3>
                <p class="card-meta" style="color: #64748b; font-size: 0.85rem; margin-bottom: 0.6rem;">
                  {{ hotel.zone }}{% if hotel.zone %}, {% endif %}{{ hotel.island }}{% if hotel.star_rating %} &bull; <strong>{{ hotel.star_rating }}</strong>{% endif %}
                </p>
                {% if hotel.category %}
                  <p class="card-description" style="font-size: 0.88rem; line-height: 1.45; color: #4e5d66; margin-bottom: 0.75rem;">
                    {{ hotel.category }}
                  </p>
                {% endif %}
                
                {% if hotel.island == "Pemba" %}
                <div class="card-perk" style="background: rgba(0, 95, 138, 0.08); border-left: 3px solid var(--dct-ocean, #005F8A); padding: 0.45rem 0.65rem; border-radius: 0 4px 4px 0; font-size: 0.8rem; margin-bottom: 1rem; color: #1b262c;">
                  ✈️ <strong>{{ 'hotels_logistics_pemba' | t(lang) }}</strong> Chake Chake Airport (PMA) / Mkoani Port transfers &amp; Misali Island marine reserve excursions.
                </div>
                {% elseif hotel.name.includes("Mnemba") or hotel.name.includes("Bawe") or hotel.name.includes("Chumbe") or hotel.name.includes("Chapwani") %}
                <div class="card-perk" style="background: rgba(0, 95, 138, 0.08); border-left: 3px solid var(--dct-ocean, #005F8A); padding: 0.45rem 0.65rem; border-radius: 0 4px 4px 0; font-size: 0.8rem; margin-bottom: 1rem; color: #1b262c;">
                  🛥️ <strong>{{ 'hotels_logistics_offshore' | t(lang) }}</strong> Dedicated boat crossing from Stone Town / Mbweni pier. Private airport road transfer connects directly to pier.
                </div>
                {% else %}
                <div class="card-perk" style="background: rgba(212, 175, 55, 0.1); border-left: 3px solid var(--dct-gold, #D4AF37); padding: 0.45rem 0.65rem; border-radius: 0 4px 4px 0; font-size: 0.8rem; margin-bottom: 1rem; color: #1b262c;">
                  ✨ <strong>Unguja Hotel Lobby Pickup:</strong> Available for Mnemba, Safari Blue, and Stone Town tours.
                </div>
                {% endif %}
                {% if hotel.partnerStay %}
                <div class="card-perk" style="background: rgba(37, 211, 102, 0.08); border-left: 3px solid #25D366; padding: 0.45rem 0.65rem; border-radius: 0 4px 4px 0; font-size: 0.8rem; margin-bottom: 1rem; color: #1b262c;">
                  🤝 <strong>{{ "hotels_partner_stay" | t(lang) }}</strong> Direct-deal rates below OTA — bundled with licensed tours &amp; transfers.
                </div>
                {% set research = partnerPropertyResearch.properties[hotel.slug] %}
                {% if research %}
                <div class="card-perk" style="background: rgba(0, 95, 138, 0.06); border-left: 3px solid var(--dct-ocean, #005F8A); padding: 0.45rem 0.65rem; border-radius: 0 4px 4px 0; font-size: 0.8rem; margin-bottom: 1rem; color: #1b262c;">
                  {% if research.viewFacts %}<strong>Views:</strong> {{ research.viewFacts }}{% endif %}
                </div>
                <div class="card-perk" style="background: rgba(12,26,36,0.04); border-left: 3px solid #94a3b8; padding: 0.45rem 0.65rem; border-radius: 0 4px 4px 0; font-size: 0.78rem; margin-bottom: 1rem; color: #33454f;">
                  {% if research.distanceFacts %}<strong>Getting there:</strong> {{ research.distanceFacts }}{% endif %}
                </div>
                {% endif %}
                {% endif %}
              </div>

              <div class="card-actions" style="margin-top: auto; display: flex; flex-direction: column; gap: 0.5rem;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                  {% if hotel.island == "Pemba" %}
                    <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20please%20quote%20Pemba%20airport%20or%20ferry%20transfer%20logistics%20for%20{{ hotel.name | urlencode }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="text-align: center; font-size: 0.8rem; padding: 0.5rem 0.3rem; background: #005F8A; border-color: #005F8A; color: #fff; font-weight: 600;" title="Pemba Airport & Ferry Transfer Logistics" onclick="window.dataLayer.push({'event': 'whatsapp_click', 'page_path': '{{ page.path }}', 'hotel': '{{ hotel.name }}'});">
                  {% elseif hotel.name.includes("Mnemba") or hotel.name.includes("Bawe") or hotel.name.includes("Chumbe") or hotel.name.includes("Chapwani") %}
                    <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20please%20quote%20boat%20transfer%20and%20airport%20connection%20for%20{{ hotel.name | urlencode }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="text-align: center; font-size: 0.8rem; padding: 0.5rem 0.3rem; background: #005F8A; border-color: #005F8A; color: #fff; font-weight: 600;" title="Boat & Airport Transfer Connection" onclick="window.dataLayer.push({'event': 'whatsapp_click', 'page_path': '{{ page.path }}', 'hotel': '{{ hotel.name }}'});">🛥️ {{ "hotels_check_rates" | t(lang) }}</a>
                  {% elseif hotel.zone == "Nungwi" or hotel.zone == "Kendwa" %}
                    <a href="/transfers/" class="btn btn-primary btn-sm" style="text-align: center; font-size: 0.8rem; padding: 0.5rem 0.3rem; background: #003853; border-color: #003853; color: #fff; font-weight: 600;" title="Private Minivan Transfer to {{ hotel.name }}">🚖 {{ "hotels_transfer" | t(lang) }} ({% catPrice "airport-transfer-znz-to-nungwikendwa" %})</a>
                  {% elseif hotel.zone == "Stone Town" %}
                    <a href="/transfers/" class="btn btn-primary btn-sm" style="text-align: center; font-size: 0.8rem; padding: 0.5rem 0.3rem; background: #003853; border-color: #003853; color: #fff; font-weight: 600;" title="Private Minivan Transfer to {{ hotel.name }}">🚖 {{ "hotels_transfer" | t(lang) }} ({% catPrice "airport-transfer-znz-to-stone-town" %})</a>
                  {% else %}
                    <a href="/transfers/" class="btn btn-primary btn-sm" style="text-align: center; font-size: 0.8rem; padding: 0.5rem 0.3rem; background: #003853; border-color: #003853; color: #fff; font-weight: 600;" title="Private Minivan Transfer to {{ hotel.name }}">🚖 {{ "hotels_transfer" | t(lang) }} ({% catPrice "airport-transfer-znz-to-pajejambiani" %})</a>
                  {% endif %}
                  <a href="https://wa.me/{{ site.contact.whatsapp }}?text=Hi%20Spice%20and%20Sail%2C%20please%20quote%20stay%20and%20tour%20packages%20for%20{{ hotel.name | urlencode }}%20in%20{{ hotel.zone | urlencode }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="text-align: center; font-size: 0.8rem; padding: 0.5rem 0.3rem; background: #25D366; border-color: #25D366; color: #fff; font-weight: 600;" title="Inquire Stay Rates for {{ hotel.name }}" onclick="window.dataLayer.push({'event': 'whatsapp_click', 'page_path': '{{ page.path }}', 'hotel': '{{ hotel.name }}'});">💬 {{ "hotels_check_rates" | t(lang) }}</a>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.35rem; padding-top: 0.5rem; border-top: 1px solid rgba(0,0,0,0.06); font-size: 0.78rem;">
                  {% if hotel.partnerStay and hotelRates.bySlug[hotel.slug] %}
                    {% set rates = hotelRates.bySlug[hotel.slug] %}
                    {% if rates.rooms[0].netRate %}
                    <span class="card-price" style="font-weight: 600; color: #0C1A24;">From ${{ rates.fromRate }}/night · direct-deal partner rate</span>
                    {% elseif rates.seasons %}
                    <span class="card-price" style="font-weight: 600; color: #0C1A24;">From ${{ rates.fromRate }}/night · {{ rates.discountPct }}% below the published rack rate</span>
                    {% else %}
                    <span class="card-price" style="font-weight: 600; color: #0C1A24;">From ${{ rates.fromRate }}/night · ~20% below OTA rates</span>
                    {% endif %}
                  {% else %}
                    <span class="card-price" style="font-weight: 600; color: #0C1A24;">{% if hotel.price_range %}{{ hotel.price_range }}{% else %}{{"hotels_seasonal_rates" | t(lang) }}{% endif %}</span>
                  {% endif %}
                  {% if hotel.website %}
                    <a href="{{ hotel.website }}" target="_blank" rel="noopener nofollow" style="color: #64748b; text-decoration: underline;" title="Visit official property website">{{ "hotels_official_site" | t(lang) }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </article>