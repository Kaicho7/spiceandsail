        <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer" class="nav-cta" data-sns-event="whatsapp_header_click" data-sns-funnel="general" data-sns-label="Header WhatsApp">{{ "btn_whatsapp_book" | t(lang) }} <span aria-hidden="true">↗</span></a>
