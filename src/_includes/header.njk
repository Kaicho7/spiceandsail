    </nav>
  </div>
  <div class="nav-overlay" id="navOverlay" aria-hidden="true"></div>
</header>

<nav class="mobile-contact-bar" id="sns-mobile-actions" aria-label="Quick contact">
  <a class="mobile-contact-action is-whatsapp" href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20I%27d%20like%20help%20planning%20my%20Zanzibar%20trip." target="_blank" rel="noopener noreferrer" data-test-label="WhatsApp">
