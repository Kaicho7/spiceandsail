<!-- Header -->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..800;1,400..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..800;1,400..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="/css/concierge.css">
<script src="/js/i18n-currency.js" defer></script>
<script src="/js/main.js" defer></script>
<script src="/js/concierge.js" defer></script>
</head>
<body>
<div id="google_translate_element" style="display:none;" aria-hidden="true"></div>
<header class="site-header" id="siteHeader">
  <!-- Top Utility Bar -->
  <div class="top-bar">
    <div class="top-bar-left">
      <span class="brand notranslate" translate="no">Spice and Sail</span>
      <span class="intent-indicator" id="intentIndicator"></span>
    </div>
    <div class="top-bar-right">
      <div class="international-bar" aria-label="Language and Currency Selectors">
        <!-- Language Switcher -->
        <div class="control-item">
          <label for="langSelect" class="sr-only">Language</label>
          <select id="langSelect" class="intl-select" title="Select Language">
            <option value="en">🇬🇧 English</option>
            <option value="it">🇮🇹 Italiano</option>
            <option value="de">🇩🇪 Deutsch</option>
            <option value="fr">🇫🇷 Français</option>
            <option value="pl">🇵🇱 Polski</option>
          </select>
        </div>
        <!-- Currency Switcher -->
        <div class="control-item">
          <label for="currencySelect" class="sr-only">Currency</label>
          <select id="currencySelect" class="intl-select" title="Select Currency">
            <option value="USD">💵 USD ($)</option>
            <option value="EUR">💶 EUR (€)</option>
            <option value="GBP">💷 GBP (£)</option>
            <option value="PLN">🇵🇱 PLN (zł)</option>
            <option value="TZS">🇹🇿 TZS (TSh)</option>
          </select>
        </div>
      </div>
      <span class="contact">
        <a href="tel:{{ site.contact.phone }}" class="top-tel" title="Call operations directly">{{ site.contact.whatsapp_display }}</a>
        <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener" class="top-wa-btn" title="Chat on WhatsApp">💬 WhatsApp</a>
      </span>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="main-nav" id="mainNav" aria-label="Main Navigation">
    <a href="/" class="logo notranslate" translate="no">
      <span class="notranslate" translate="no">Spice and Sail</span>
    </a>

    <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navMenu">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <div class="nav-menu" id="navMenu">
      <ul class="nav-list">
        <!-- 1. Tours & Experiences Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/tours/" class="nav-link dropdown-toggle" data-i18n="nav_tours">
            Tours &amp; Experiences <span class="dropdown-arrow" aria-hidden="true">▾</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/tours/" data-i18n="nav_all_tours">All Tours &amp; Day Trips</a></li>
            <li><a href="/tours/safari-blue/">Safari Blue Dhow Day</a></li>
            <li><a href="/tours/mnemba-snorkeling/">Mnemba Atoll Snorkeling</a></li>
            <li><a href="/tours/stone-town-walking-tour/">Stone Town Walking Tour</a></li>
            <li><a href="/experiences/" data-i18n="nav_rare_experiences">Rare Hidden Gems</a></li>
            <li><a href="/spice-farm-cultural/" data-i18n="nav_spice_farm">Spice Farm Tour</a></li>
            <li><a href="/attractions/" data-i18n="nav_attractions">Island Attractions</a></li>
          </ul>
        </li>

        <!-- 2. Airport Transfers Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/transfers/" class="nav-link dropdown-toggle" data-i18n="nav_transfers">
            Transfers <span class="dropdown-arrow" aria-hidden="true">▾</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/transfers/" data-i18n="nav_airport_transfers">Airport &amp; Inter-Hotel Transfers</a></li>
            <li><a href="/transfers/airport-to-nungwi/" data-i18n="nav_nungwi_transfer">Airport to Nungwi &amp; Kendwa</a></li>
            <li><a href="/self-drive/" data-i18n="nav_self_drive">Self-Drive &amp; 4x4 Rental</a></li>
          </ul>
        </li>

        <!-- 3. Safaris & Packages Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/safaris/" class="nav-link dropdown-toggle" data-i18n="nav_safaris_packages">
            Safaris &amp; Packages <span class="dropdown-arrow" aria-hidden="true">▾</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/safaris/" data-i18n="nav_safaris">Mainland Safaris from Zanzibar</a></li>
            <li><a href="/safaris/mikumi-day-trip/" data-i18n="nav_mikumi">Mikumi 1-Day Fly-in Safari</a></li>
            <li><a href="/packages/" data-i18n="nav_packages">Multi-Day Island Packages</a></li>
            <li><a href="/packages/zanzibar-essentials-3day/">Zanzibar Essentials 3-Day</a></li>
            <li><a href="/honeymoon-packages/" data-i18n="nav_honeymoon">Honeymoon Packages</a></li>
            <li><a href="/family-travel/" data-i18n="nav_family">Family Travel</a></li>
          </ul>
        </li>

        <!-- 4. Hotels & Areas Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/hotels/" class="nav-link dropdown-toggle" data-i18n="nav_hotels_areas">
            Hotels &amp; Areas <span class="dropdown-arrow" aria-hidden="true">▾</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/hotels/" data-i18n="nav_hotels">Zanzibar Hotels &amp; Resorts</a></li>
            <li><a href="/areas/" data-i18n="nav_areas">Coastlines &amp; Areas</a></li>
            <li><a href="/areas/stone-town/">Stone Town</a></li>
            <li><a href="/areas/nungwi/">Nungwi &amp; Kendwa</a></li>
            <li><a href="/areas/paje/">Paje &amp; Jambiani</a></li>
          </ul>
        </li>

        <!-- 5. Travel Guide Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/travel-guide/" class="nav-link dropdown-toggle" data-i18n="nav_travel_guide">
            Travel Guide <span class="dropdown-arrow" aria-hidden="true">▾</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/travel-guide/" data-i18n="nav_travel_guide">Complete Travel Guide</a></li>
            <li><a href="/cancellation/" data-i18n="nav_visas_levies">Cancellation &amp; Weather Policy</a></li>
            <li><a href="/health-safety/" data-i18n="nav_health_safety">Health &amp; Safety Guide</a></li>
            <li><a href="/migration-calendar/" data-i18n="nav_migration">Migration Calendar</a></li>
            <li><a href="/packing-guide/">Packing Guide</a></li>
          </ul>
        </li>

        <!-- 6. About & Contact Links -->
        <li class="nav-item">
          <a href="/about/" class="nav-link" data-i18n="nav_about">About</a>
        </li>
        <li class="nav-item">
          <a href="/contact/" class="nav-link" data-i18n="nav_contact">Contact</a>
        </li>
      </ul>

      <!-- Quick WhatsApp Nav Button -->
      <div class="nav-cta">
        <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener" class="btn btn-nav-wa" title="Instant WhatsApp Booking">
          <span>💬</span> <span data-i18n="btn_whatsapp_book">Book on WhatsApp</span>
        </a>
      </div>
    </div>
  </nav>
  <div class="nav-overlay" id="navOverlay" aria-hidden="true"></div>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const intentIndicators = {family: '👨‍👩‍👧‍👦', honeymoon: '💑', selfdrive: '🚗', migration: '🐋', health: '🏥', tribes: '🌿', packing: '🎒', spice: '🌿'};
    const path = window.location.pathname;
    const ind = document.getElementById('intentIndicator');
    if (ind) {
      if (path.includes('family-travel')) ind.textContent = intentIndicators.family;
      else if (path.includes('honeymoon-packages')) ind.textContent = intentIndicators.honeymoon;
      else if (path.includes('self-drive')) ind.textContent = intentIndicators.selfdrive;
      else if (path.includes('migration-calendar')) ind.textContent = intentIndicators.migration;
      else if (path.includes('health-safety')) ind.textContent = intentIndicators.health;
      else if (path.includes('tribes-culture')) ind.textContent = intentIndicators.tribes;
      else if (path.includes('packing-guide')) ind.textContent = intentIndicators.packing;
      else if (path.includes('spice-farm-cultural')) ind.textContent = intentIndicators.spice;
    }
  });
  </script>
</header>
