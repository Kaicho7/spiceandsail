<!-- Shared Spice & Sail header. All shared page chrome inherits eco-swahili.css. -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/eco-swahili.css">
<script src="/js/i18n-currency.js" defer></script>
<script src="/js/main.js" defer></script>
<script src="/js/language-switcher.js" defer></script>

<script src="/js/eco-swahili.js?v=20261126" defer></script>
</head>
<body data-whatsapp-number="{{ site.contact.whatsapp }}">
<a href="#main-content" class="skip-link">Skip to main content</a>
  <noscript>
    <div class="noscript-banner" role="alert">
      <p>This site works best with JavaScript enabled. Some features (currency conversion, interactive fare calculator, WhatsApp booking panel) may not function correctly.</p>
      <p>You can still contact us directly via <a href="https://wa.me/{{ site.contact.whatsapp }}">WhatsApp</a> or email {{ site.contact.email }}.</p>
    </div>
  </noscript>
<div id="google_translate_element" hidden aria-hidden="true"></div>

<header class="site-header" id="siteHeader">
  <div class="header-shell">
    <div class="top-bar">
      <a href="{{ 'home' | navUrl(lang) }}" class="logo notranslate" translate="no" aria-label="S&amp;S Spice &amp; Sail Zanzibar home">
        <span class="logo-mark" aria-hidden="true">S&amp;S</span>
        <span class="logo-name">Spice <em>&amp;</em> Sail</span>
      </a>

      <div class="top-bar-right">
        <div class="international-bar" aria-label="Language and currency preferences">
          <div class="control-item">
            <label for="langSelect" class="sr-only">Language</label>
            <select id="langSelect" class="intl-select" title="Choose language"
              data-page-lang="{{ lang or 'en' }}"
              data-alt-en="{{ alternate_en or page.url }}"
              data-alt-it="{{ alternate_it or '' }}"
              data-alt-de="{{ alternate_de or '' }}"
              data-alt-fr="{{ alternate_fr or '' }}"
              data-alt-pl="{{ alternate_pl or '' }}"
              data-alt-ar="{{ alternate_ar or '' }}"
              data-alt-ru="{{ alternate_ru or '' }}">
              <option value="en">EN</option>
              <option value="it">IT</option>
              <option value="de">DE</option>
              <option value="fr">FR</option>
              <option value="pl">PL</option>
              <option value="ar">AR</option>
              <option value="ru">RU</option>
            </select>
          </div>
          <div class="control-item">
            <label for="currencySelect" class="sr-only">Currency</label>
            <select id="currencySelect" class="intl-select" title="Indicative display currency; final quote is confirmed by our team">
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
              <option value="PLN">PLN</option>
              <option value="TZS">TZS</option>
            </select>
          </div>
        </div>
        <div class="header-contact">
          <a href="tel:{{ site.contact.phone }}" class="header-phone">{{ site.contact.phone_display }}</a>
          <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer" class="header-whatsapp">WhatsApp</a>
        </div>
      </div>

      <button class="nav-toggle" id="navToggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="navMenu">
        <span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span>
      </button>
    </div>

