<!-- Shared Spice & Sail header. All shared page chrome inherits eco-swahili.css. -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/eco-swahili.css">
<script src="/js/i18n-currency.js" defer></script>
<script src="/js/main.js" defer></script>

<script src="/js/eco-swahili.js" defer></script>
</head>
<body data-whatsapp-number="{{ site.contact.whatsapp }}">
<div id="google_translate_element" hidden aria-hidden="true"></div>

<header class="site-header" id="siteHeader">
  <div class="header-shell">
    <div class="top-bar">
      <a href="/" class="logo notranslate" translate="no" aria-label="S&amp;S Spice &amp; Sail Zanzibar home">
        <span class="logo-mark" aria-hidden="true">S&amp;S</span>
        <span class="logo-name">Spice <em>&amp;</em> Sail</span>
      </a>

      <div class="top-bar-right">
        <div class="international-bar" aria-label="Language and currency preferences">
          <div class="control-item">
            <label for="langSelect" class="sr-only">Language</label>
            <select id="langSelect" class="intl-select" title="Choose language">
              <option value="en">EN</option>
              <option value="it">IT</option>
              <option value="de">DE</option>
              <option value="fr">FR</option>
              <option value="pl">PL</option>
            </select>
          </div>
          <div class="control-item">
            <label for="currencySelect" class="sr-only">Currency</label>
            <select id="currencySelect" class="intl-select" title="Indicative display currency; final quote is confirmed by our team">
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
              <option value="PLN">PLN</option>
              <option value="TZS">TZS</option>
            </select>
          </div>
        </div>
        <div class="header-contact">
          <a href="tel:{{ site.contact.phone }}" class="header-phone">{{ site.contact.phone_display }}</a>
          <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer" class="header-whatsapp">WhatsApp</a>
        </div>
      </div>

      <button class="nav-toggle" id="navToggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="navMenu">
        <span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span>
      </button>
    </div>

<nav class="main-nav" id="mainNav" aria-label="Main navigation">
      <div class="nav-menu" id="navMenu">
        <ul class="nav-list">
          <li class="nav-item has-dropdown">
            <a href="/tours/" class="nav-link dropdown-toggle">{{ "nav_tours" | t(lang) }} <span class="dropdown-arrow" aria-hidden="true">⌄</span></a>
            <ul class="dropdown-menu">
              <li><a href="/tours/">{{ "nav_all_tours" | t(lang) }}</a></li>
              <li><a href="/tours/safari-blue/">{{ "nav_safari_blue" | t(lang) }}</a></li>
              <li><a href="/tours/mnemba-snorkeling/">{{ "nav_mnemba_snorkeling" | t(lang) }}</a></li>
              <li><a href="/tours/stone-town-walking-tour/">{{ "nav_stone_town_walking_tour" | t(lang) }}</a></li>
              <li><a href="/experiences/">{{ "nav_rare_experiences" | t(lang) }}</a></li>
              <li><a href="/spice-farm-cultural/">{{ "nav_spice_farm" | t(lang) }}</a></li>
              <li><a href="/attractions/">{{ "nav_attractions" | t(lang) }}</a></li>
            </ul>
          </li>
          <li class="nav-item has-dropdown">
            <a href="/transfers/" class="nav-link dropdown-toggle">{{ "nav_transfers" | t(lang) }} <span class="dropdown-arrow" aria-hidden="true">⌄</span></a>
            <ul class="dropdown-menu">
              <li><a href="/transfers/">{{ "nav_airport_transfers" | t(lang) }}</a></li>
              <li><a href="/transfers/airport-to-nungwi/">{{ "nav_nungwi_transfer" | t(lang) }}</a></li>
              <li><a href="/self-drive/">{{ "nav_self_drive" | t(lang) }}</a></li>
            </ul>
          </li>
          <li class="nav-item has-dropdown">
            <a href="/safaris/" class="nav-link dropdown-toggle">{{ "nav_safaris_packages" | t(lang) }} <span class="dropdown-arrow" aria-hidden="true">⌄</span></a>
            <ul class="dropdown-menu">
              <li><a href="/safaris/">{{ "nav_safaris" | t(lang) }}</a></li>
              <li><a href="/safaris/mikumi-day-trip/">{{ "nav_mikumi" | t(lang) }}</a></li>
              <li><a href="/packages/">{{ "nav_packages" | t(lang) }}</a></li>
              <li><a href="/packages/zanzibar-essentials-3day/">{{ "nav_zanzibar_essentials" | t(lang) }}</a></li>
              <li><a href="/honeymoon-packages/">{{ "nav_honeymoon" | t(lang) }}</a></li>
              <li><a href="/family-travel/">{{ "nav_family" | t(lang) }}</a></li>
            </ul>
          </li>
          <li class="nav-item has-dropdown">
            <a href="/hotels/" class="nav-link dropdown-toggle">{{ "nav_hotels_areas" | t(lang) }} <span class="dropdown-arrow" aria-hidden="true">⌄</span></a>
            <ul class="dropdown-menu">
              <li><a href="/hotels/">{{ "nav_hotels" | t(lang) }}</a></li>
              <li><a href="/areas/">{{ "nav_areas" | t(lang) }}</a></li>
              <li><a href="/areas/stone-town/">{{ "nav_stone_town" | t(lang) }}</a></li>
              <li><a href="/areas/nungwi/">{{ "nav_nungwi_kendwa" | t(lang) }}</a></li>
              <li><a href="/areas/paje/">{{ "nav_paje_jambiani" | t(lang) }}</a></li>
            </ul>
          </li>
          <li class="nav-item has-dropdown">
            <a href="/travel-guide/" class="nav-link dropdown-toggle">{{ "nav_travel_guide" | t(lang) }} <span class="dropdown-arrow" aria-hidden="true">⌄</span></a>
            <ul class="dropdown-menu">
              <li><a href="/travel-guide/">{{ "nav_travel_guide" | t(lang) }}</a></li>
              <li><a href="/blog/">{{ "nav_blog" | t(lang) }}</a></li>
              <li><a href="/cancellation/">{{ "nav_visas_levies" | t(lang) }}</a></li>
              <li><a href="/health-safety/">{{ "nav_health_safety" | t(lang) }}</a></li>
              <li><a href="/migration-calendar/">{{ "nav_migration" | t(lang) }}</a></li>
              <li><a href="/packing-guide/">{{ "nav_packing_guide" | t(lang) }}</a></li>
            </ul>
          </li>
          <li class="nav-item"><a href="/about/" class="nav-link">{{ "nav_about" | t(lang) }}</a></li>
          <li class="nav-item"><a href="/contact/" class="nav-link">{{ "nav_contact" | t(lang) }}</a></li>
        </ul>
        <a href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer" class="nav-cta">{{ "btn_whatsapp_book" | t(lang) }} <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </div>
  <div class="nav-overlay" id="navOverlay" aria-hidden="true"></div>
</header>

<nav class="mobile-contact-bar" id="sns-mobile-actions" aria-label="Quick contact">
  <a class="mobile-contact-action is-whatsapp" href="https://wa.me/{{ site.contact.whatsapp }}?text=Jambo%20Spice%20%26%20Sail%2C%20I%27d%20like%20help%20planning%20my%20Zanzibar%20trip." target="_blank" rel="noopener noreferrer" data-test-label="WhatsApp">
    <span aria-hidden="true">◉</span><span>{{ "mobile_whatsapp" | t(lang) }}</span>
    <span class="visually-hidden">>WhatsApp<</span>
  </a>
  <a class="mobile-contact-action" href="tel:{{ site.contact.phone }}" data-test-label="Call">
    <span aria-hidden="true">☎</span><span>{{ "mobile_call" | t(lang) }}</span>
    <span class="visually-hidden">>Call<</span>
  </a>
  <a class="mobile-contact-action is-enquire" href="/contact/" data-sns-open data-test-label="Enquire">
    <span aria-hidden="true">✉</span><span>{{ "mobile_enquire" | t(lang) }}</span>
    <span class="visually-hidden">>Enquire<</span>
  </a>
</nav>
