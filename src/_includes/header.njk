  </a>
  <a class="mobile-contact-action is-enquire" href="{{ 'contact' | navUrl(lang) }}" data-sns-open data-test-label="Enquire">
    <span aria-hidden="true">✉</span><span>{{ "mobile_enquire" | t(lang) }}</span>
  </a>
