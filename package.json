{
  "name": "spiceandsail",
  "version": "1.0.0",
  "description": "Static tourism website for Zanzibar with SEO and direct booking",
  "scripts": {
    "build": "rm -rf dist && eleventy && node scripts/normalize_img_alt.js && node scripts/add-img-dimensions.js && node scripts/check-images.js",
    "test": "node --test tests/*.test.js",
    "start": "eleventy --serve",
    "preview:local": "npm run build && node scripts/local-preview-server.js",
    "rates:sync": "node scripts/hotel-rates-sync.js",
    "catalogue:build": "node scripts/catalogue-build.js",
    "rates:sync:apply": "node scripts/hotel-rates-sync.js --apply"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1"
  },
  "main": ".eleventy.js",
  "dependencies": {
    "@netlify/blobs": "^11.1.7",
    "slugify": "^1.6.6",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.3"
  }
}
