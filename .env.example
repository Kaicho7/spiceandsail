# Spice & Sail — Required Environment Variables for Netlify Functions
# Copy to .env.local for local dev, or set in Netlify Dashboard → Site Settings → Environment Variables

# =============================================================================
# NETLIFY BLOBS (Required for lead/chat persistence)
# Enable Netlify Blobs in Netlify Dashboard → Site Settings → Blobs
# No additional config needed — functions auto-detect NETLIFY env and use 'blob' store
# =============================================================================

# =============================================================================
# ALERT WEBHOOKS (Optional but recommended for operations)
# At least one should be configured to receive lead notifications
# =============================================================================

# WhatsApp Business API webhook for ops team (e.g., via Twilio, 360dialog, or custom)
WHATSAPP_OPS_WEBHOOK_URL=https://your-webhook-endpoint.com/whatsapp

# Generic ops webhook (JSON payload with lead details)
OPS_WEBHOOK_URL=https://your-webhook-endpoint.com/ops

# Discord webhook for team channel notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Slack webhook for team channel notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# =============================================================================
# EMAIL ALERTS (Optional — requires Resend account)
# =============================================================================

# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address to receive lead alerts (must be verified in Resend)
ALERT_EMAIL=alerts@yourdomain.com

# From email for alerts (must be verified domain in Resend)
ALERT_FROM_EMAIL=alerts@spiceandsail.com

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Canonical site URL (used for sitemap, canonical tags, CSP)
SITE_URL=https://spiceandsail.com

# Business WhatsApp number (E.164 format, no +)
BUSINESS_WHATSAPP=255672450934

# Business email
BUSINESS_EMAIL=info@spiceandsail.com

# =============================================================================
# ANALYTICS & TRACKING (Optional)
# =============================================================================

# AI concierge (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional OpenAI-compatible fallback
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Admin lead dashboard passcode
STAFF_PASSCODE=

# Review links (leave empty to disable review-capture)
GBP_REVIEW_LINK=
TRIPADVISOR_REVIEW_LINK=

# Google Analytics 4 Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager ID
GTM_ID=GTM-XXXXXXX

# =============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# =============================================================================

# Tavily API key for web search (used in some functions)
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# Firecrawl API key for web scraping
FIRECRAWL_API_KEY=fc_xxxxxxxxxxxx

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Force in-memory store even on Netlify (for testing)
# FORCE_MEMORY_STORE=true

# Skip rate limiting in development
# SKIP_RATE_LIMIT=true